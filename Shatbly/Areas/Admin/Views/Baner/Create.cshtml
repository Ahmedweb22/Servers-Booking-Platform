@model Banner
<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h3 class="display-6">Create New Banner</h3>
        </div>
        <!-- Back -->
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/Admin/Baner/Index" class="btn btn-danger">
                >> Back
            </a>
        </div>
    </div>

    <div class="row my-3">
        <div class="col-12">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title</label>
                    <input asp-for="Title" class="form-control" placeholder="Enter banner title">
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LinkUrl" class="form-label">Link URL</label>
                    <input asp-for="LinkUrl" class="form-control" placeholder="Enter link URL">
                    <span asp-validation-for="LinkUrl" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" class="form-control" placeholder="Enter start date" type="date">
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" class="form-control" placeholder="Enter end date" type="date">
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Banner Image</label>
                    <input type="file" name="img" class="form-control"> 
                    @* <label asp-for="ImageUrl" class="form-label">Banner Image</label>
                    <input asp-for="ImageUrl" type="file" class="form-control" placeholder="Enter banner image"> *@
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>
                <!-- Image Preview Area -->
                <div class="mb-3" id="imagePreviewContainer" style="display: none;">
                    <label class="form-label">Img Preview</label>
                    <div class="border rounded p-2 text-center" style="max-width: 300px;">
                        <img id="imagePreview" src="#" alt="Image Preview" style="max-width: 100%; max-height: 250px;" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label asp-for="Target" class="form-label">Target</label>
                    <select asp-for="Target" class="form-control" asp-items="Html.GetEnumSelectList<BannerTarget>()">
                    </select>
                    <span asp-validation-for="Target" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="IsActive" class="form-label">Status</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </div>
</div>

<script>
    function previewImage(event) {
        const input = event.target;
        const preview = document.getElementById('imagePreview');
        const previewContainer = document.getElementById('imagePreviewContainer');

        if (input.files && input.files[0]) {
            const reader = new FileReader();

            reader.onload = function(e) {
                preview.src = e.target.result;
                previewContainer.style.display = 'block';
            };

            reader.readAsDataURL(input.files[0]);
        } else {
            previewContainer.style.display = 'none';
        }
    }
</script>

@section Scripts {
    <partial name="~/Views/Shared/_NotificationPartial.cshtml" />
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
