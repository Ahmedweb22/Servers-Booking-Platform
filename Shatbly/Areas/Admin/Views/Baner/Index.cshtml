@model BannersVM
@using Microsoft.AspNetCore.Localization
@using Shatbly.Utilities
@{
    var reqCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var curCulture = reqCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isRtl = curCulture.StartsWith("ar");
    ViewBag.Title = isRtl ? "إدارة الإعلانات واللافتات" : "Banners Management";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 my-3 @(isRtl ? "text-end flex-row-reverse" : "text-start")">
        <div>
            <h2 class="fw-bold mb-1">@(isRtl ? "إدارة الإعلانات واللافتات" : "Banners Management")</h2>
            <p class="text-muted mb-0">@(isRtl ? "عرض وإدارة إعلانات البانر واللافتات الترويجية المعروضة على المنصة" : "View and manage promotional banners and sliders displayed on the platform")</p>
        </div>
        <div>
            <a href="/Admin/Baner/Create" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> @(isRtl ? "إضافة إعلان جديد" : "Create New Banner")
            </a>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="dashboard-card mb-4 p-3">
        <form method="get" class="row align-items-center g-3">
            <div class="col-12 col-md-5 @(isRtl ? "ms-auto" : "")">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="title" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 bg-light" 
                           placeholder="@(isRtl ? "البحث عن طريق عنوان الإعلان..." : "Search by banner title...")" />
                    @if (ViewData["CurrentFilter"] != null && !string.IsNullOrEmpty(ViewData["CurrentFilter"].ToString()))
                    {
                        <a href="/Admin/Baner/Index" class="btn btn-outline-secondary d-flex align-items-center">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                    <button class="btn btn-primary" type="submit">@(isRtl ? "بحث" : "Search")</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="dashboard-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr class="@(isRtl ? "text-end" : "text-start")">
                        <th scope="col" style="width: 80px;">ID</th>
                        <th scope="col">@(isRtl ? "العنوان" : "Title")</th>
                        <th scope="col" style="width: 150px;">@(isRtl ? "صورة الإعلان" : "Image")</th>
                        <th scope="col">@(isRtl ? "الرابط" : "Link")</th>
                        <th scope="col">@(isRtl ? "الهدف" : "Target")</th>
                        <th scope="col">@(isRtl ? "تاريخ البدء" : "Start Date")</th>
                        <th scope="col">@(isRtl ? "تاريخ الانتهاء" : "End Date")</th>
                        <th scope="col" style="width: 120px;">@(isRtl ? "الحالة" : "Status")</th>
                        <th scope="col" class="text-center" style="width: 220px;">@(isRtl ? "العمليات" : "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Banners == null || !Model.Banners.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-images fs-1 d-block mb-3 opacity-50"></i>
                                @(isRtl ? "لم يتم العثور على إعلانات." : "No banners found.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Banners)
                        {
                            <tr class="@(isRtl ? "text-end" : "text-start")">
                                <td class="fw-bold text-dark">@item.Id</td>
                                <td class="fw-semibold text-dark">@item.Title</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="~/img/banners/@item.ImageUrl" class="rounded border bg-white p-1" 
                                             style="max-width: 100px; max-height: 50px; object-fit: cover;" asp-append-version="true" />
                                    }
                                    else
                                    {
                                        <div class="rounded border bg-light d-flex align-items-center justify-content-center" style="width: 100px; height: 50px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.LinkUrl))
                                    {
                                        <a href="@item.LinkUrl" target="_blank" class="btn btn-link btn-sm p-0 text-decoration-none">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> @(isRtl ? "زيارة الرابط" : "Visit Link")
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.Target</span></td>
                                <td class="text-secondary small">@item.StartDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-secondary small">@item.EndDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1.5 fw-semibold" style="font-size: 0.8rem;">
                                            @(isRtl ? "نشط" : "Active")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1.5 fw-semibold" style="font-size: 0.8rem;">
                                            @(isRtl ? "غير نشط" : "Inactive")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        @if (User.IsInRole(SD.ROLE_SUPER_ADMIN) || User.IsInRole(SD.ROLE_ADMIN))
                                        {
                                            <a href="/Admin/Baner/Edit/@item.Id"
                                               class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-semibold">
                                                <i class="bi bi-pencil-square me-1"></i> @(isRtl ? "تعديل" : "Edit")
                                            </a>
                                            <a href="/Admin/Baner/Delete/@item.Id"
                                               class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-semibold js-delete-banner"
                                               data-id="@item.Id" data-name="@item.Title">
                                                <i class="bi bi-trash-fill me-1"></i> @(isRtl ? "حذف" : "Delete")
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@(isRtl ? "لا توجد صلاحيات" : "No Actions")</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="row mb-4">
            <div class="col-12 d-flex justify-content-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center gap-1">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;" 
                               href="/Admin/Baner/Index?page=@(Model.CurrentPage - 1)" aria-label="Previous">
                                <i class="bi bi-chevron-@(isRtl ? "right" : "left")"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;"
                                   href="/Admin/Baner/Index?page=@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;"
                               href="/Admin/Baner/Index?page=@(Model.CurrentPage + 1)" aria-label="Next">
                                <i class="bi bi-chevron-@(isRtl ? "left" : "right")"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const isRtl = '@isRtl' === 'True';
        const deleteLinks = document.querySelectorAll('.js-delete-banner');
        deleteLinks.forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                const url = this.href;
                const name = this.dataset.name;
                Swal.fire({
                    title: isRtl ? "هل أنت متأكد؟" : "Are you sure?",
                    text: isRtl ? `هل ترغب في حذف الإعلان "${name}"؟ لا يمكن التراجع عن هذا الإجراء.` : `Do you want to delete banner "${name}"? This action cannot be undone.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: isRtl ? "نعم، احذفه!" : "Yes, delete it!",
                    cancelButtonText: isRtl ? "إلغاء" : "Cancel"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    });
</script>
