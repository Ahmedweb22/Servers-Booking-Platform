@model Shatbly.ViewModels.BookingVM
@using Microsoft.AspNetCore.Localization
@using Shatbly.Models
@using Shatbly.Utilities
@{
    var reqCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var curCulture = reqCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isRtl = curCulture.StartsWith("ar");
    ViewBag.Title = isRtl ? "إدارة الحجوزات" : "Booking Management";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 my-3 @(isRtl ? "text-end flex-row-reverse" : "text-start")">
        <div>
            <h2 class="fw-bold mb-1">@(isRtl ? "إدارة الحجوزات" : "Bookings")</h2>
            <p class="text-muted mb-0">@(isRtl ? "عرض وإدارة ومتابعة طلبات الحجز والخدمات النشطة" : "View, manage, and monitor service booking requests and active jobs")</p>
        </div>
        <div>
            <a href="/Admin/Booking/Create" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> @(isRtl ? "إنشاء حجز جديد" : "Create Booking")
            </a>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="dashboard-card mb-4 p-3">
        <form method="get" class="row align-items-center g-3">
            <div class="col-12 col-md-5 @(isRtl ? "ms-auto" : "")">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="name" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 bg-light" 
                           placeholder="@(isRtl ? "البحث عن طريق اسم العميل أو كود الخصم..." : "Search by client name or promo code...")" />
                    @if (ViewData["CurrentFilter"] != null && !string.IsNullOrEmpty(ViewData["CurrentFilter"].ToString()))
                    {
                        <a href="/Admin/Booking/Index" class="btn btn-outline-secondary d-flex align-items-center">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                    <button class="btn btn-primary" type="submit">@(isRtl ? "بحث" : "Search")</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="dashboard-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr class="@(isRtl ? "text-end" : "text-start")">
                        <th scope="col" style="width: 80px;">ID</th>
                        <th scope="col">@(isRtl ? "العميل" : "Client")</th>
                        <th scope="col">@(isRtl ? "الفني / العامل" : "Worker")</th>
                        <th scope="col" style="width: 150px;">@(isRtl ? "الحالة" : "Status")</th>
                        <th scope="col">@(isRtl ? "تاريخ الحجز" : "Scheduled At")</th>
                        <th scope="col" style="width: 120px;">@(isRtl ? "إجمالي السعر" : "Total Price")</th>
                        <th scope="col" class="text-center" style="width: 260px;">@(isRtl ? "العمليات" : "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Bookings == null || !Model.Bookings.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-3 opacity-50"></i>
                                @(isRtl ? "لم يتم العثور على حجوزات." : "No bookings found.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Bookings)
                        {
                            var statusBadge = "bg-secondary";
                            switch(item.Status)
                            {
                                case BookingStatus.Pending:
                                    statusBadge = "bg-warning text-dark";
                                    break;
                                case BookingStatus.Confirmed:
                                    statusBadge = "bg-info text-dark";
                                    break;
                                case BookingStatus.InProgress:
                                    statusBadge = "bg-primary text-white";
                                    break;
                                case BookingStatus.Completed:
                                    statusBadge = "bg-success text-white";
                                    break;
                                case BookingStatus.Cancelled:
                                    statusBadge = "bg-secondary text-white";
                                    break;
                                case BookingStatus.Disputed:
                                    statusBadge = "bg-danger text-white";
                                    break;
                            }

                            var clientName = item.Client != null ? $"{item.Client.FName} {item.Client.LName}".Trim() : "";
                            if (string.IsNullOrWhiteSpace(clientName))
                            {
                                clientName = item.Client?.UserName ?? (isRtl ? "عميل غير معروف" : "Unknown Client");
                            }

                            var workerName = item.Worker?.User != null ? $"{item.Worker.User.FName} {item.Worker.User.LName}".Trim() : "";
                            if (string.IsNullOrWhiteSpace(workerName))
                            {
                                workerName = item.Worker?.User?.UserName ?? $"{(isRtl ? "فني #" : "Worker #")}{item.WorkerId}";
                            }

                            <tr class="@(isRtl ? "text-end" : "text-start")">
                                <td class="fw-bold text-dark">@item.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2 justify-content-start @(isRtl ? "flex-row-reverse" : "")">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-person text-secondary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@clientName</div>
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">@item.Client?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2 justify-content-start @(isRtl ? "flex-row-reverse" : "")">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-tools text-secondary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@workerName</div>
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">@item.Worker?.User?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill px-3 py-1.5 fw-semibold @statusBadge" style="font-size: 0.8rem;">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-secondary fw-semibold">
                                    @item.ScheduledAt.ToString("g")
                                </td>
                                <td class="fw-bold text-dark">
                                    EGP @item.TotalPrice.ToString("N2")
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/Admin/Booking/Details/@item.Id"
                                           class="btn btn-outline-info btn-sm px-3 rounded-pill fw-semibold">
                                            <i class="bi bi-eye-fill me-1"></i> @(isRtl ? "تفاصيل" : "Details")
                                        </a>
                                        <a href="/Admin/Booking/Edit/@item.Id"
                                           class="btn btn-outline-warning btn-sm px-3 rounded-pill fw-semibold">
                                            <i class="bi bi-pencil-square me-1"></i> @(isRtl ? "تعديل" : "Edit")
                                        </a>
                                        <a href="/Admin/Booking/Delete/@item.Id"
                                           class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-semibold js-delete-booking"
                                           data-id="@item.Id">
                                            <i class="bi bi-trash-fill me-1"></i> @(isRtl ? "حذف" : "Delete")
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="row mb-4">
            <div class="col-12 d-flex justify-content-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center gap-1">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;" 
                               href="/Admin/Booking/Index?page=@(Model.CurrentPage - 1)" aria-label="Previous">
                                <i class="bi bi-chevron-@(isRtl ? "right" : "left")"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;"
                                   href="/Admin/Booking/Index?page=@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;"
                               href="/Admin/Booking/Index?page=@(Model.CurrentPage + 1)" aria-label="Next">
                                <i class="bi bi-chevron-@(isRtl ? "left" : "right")"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const isRtl = '@isRtl' === 'True';
        const deleteLinks = document.querySelectorAll('.js-delete-booking');
        deleteLinks.forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                const url = this.href;
                const id = this.dataset.id;
                Swal.fire({
                    title: isRtl ? "هل أنت متأكد؟" : "Are you sure?",
                    text: isRtl ? `هل ترغب في حذف الحجز رقم #${id}؟ لا يمكن التراجع عن هذا الإجراء.` : `Do you want to delete Booking #${id}? This action cannot be undone.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: isRtl ? "نعم، احذفه!" : "Yes, delete it!",
                    cancelButtonText: isRtl ? "إلغاء" : "Cancel"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    });
</script>

@section Scripts {
    <partial name="~/Views/Shared/_NotificationPartial.cshtml" />
}
