@model PromotionCodesVM
@using Microsoft.AspNetCore.Localization
@{
    var reqCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var curCulture = reqCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isRtl = curCulture.StartsWith("ar");
    ViewBag.Title = isRtl ? "أكواد العروض والترويج" : "Promotion Codes";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 my-3 @(isRtl ? "text-end flex-row-reverse" : "text-start")">
        <div>
            <h2 class="fw-bold mb-1">@(isRtl ? "أكواد العروض والترويج" : "Promotion Codes")</h2>
            <p class="text-muted mb-0">@(isRtl ? "عرض وإدارة أكواد العروض وقسائم التخفيض المتاحة للمستخدمين" : "View and manage promotional codes and discount vouchers available for users")</p>
        </div>
        <div>
            <a href="/Admin/PromotionCode/Create" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> @(isRtl ? "إضافة كود جديد" : "Create New Code")
            </a>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="dashboard-card mb-4 p-3">
        <form method="get" class="row align-items-center g-3">
            <div class="col-12 col-md-5 @(isRtl ? "ms-auto" : "")">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="code" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 bg-light" 
                           placeholder="@(isRtl ? "البحث عن طريق الكود الترويجي..." : "Search by promotion code...")" />
                    @if (ViewData["CurrentFilter"] != null && !string.IsNullOrEmpty(ViewData["CurrentFilter"].ToString()))
                    {
                        <a href="/Admin/PromotionCode/Index" class="btn btn-outline-secondary d-flex align-items-center">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                    <button class="btn btn-primary" type="submit">@(isRtl ? "بحث" : "Search")</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Data Table Card -->
    <div class="dashboard-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr class="@(isRtl ? "text-end" : "text-start")">
                        <th scope="col" style="width: 80px;">ID</th>
                        <th scope="col">@(isRtl ? "الكود الترويجي" : "Code")</th>
                        <th scope="col">@(isRtl ? "أقصى عدد للاستخدام" : "Max Uses")</th>
                        <th scope="col">@(isRtl ? "مرات الاستخدام" : "Used Count")</th>
                        <th scope="col" style="width: 150px;">@(isRtl ? "الحالة" : "Status")</th>
                        <th scope="col" class="text-center" style="width: 220px;">@(isRtl ? "العمليات" : "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PromotionCodes == null || !Model.PromotionCodes.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-ticket-perforated fs-1 d-block mb-3 opacity-50"></i>
                                @(isRtl ? "لم يتم العثور على أكواد ترويجية." : "No promotion codes found.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.PromotionCodes)
                        {
                            <tr class="@(isRtl ? "text-end" : "text-start")">
                                <td class="fw-bold text-dark">@item.Id</td>
                                <td class="fw-bold text-primary">@item.Code</td>
                                <td class="text-secondary">@item.MaxUses</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.UsedCount / @item.MaxUses
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1.5 fw-semibold" style="font-size: 0.8rem;">
                                            @(isRtl ? "نشط" : "Active")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1.5 fw-semibold" style="font-size: 0.8rem;">
                                            @(isRtl ? "غير نشط" : "Inactive")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/Admin/PromotionCode/Edit/@item.Id"
                                           class="btn btn-outline-primary btn-sm px-3 rounded-pill fw-semibold">
                                            <i class="bi bi-pencil-square me-1"></i> @(isRtl ? "تعديل" : "Edit")
                                        </a>
                                        <a href="/Admin/PromotionCode/Delete/@item.Id"
                                           class="btn btn-outline-danger btn-sm px-3 rounded-pill fw-semibold js-delete-code"
                                           data-id="@item.Id" data-name="@item.Code">
                                            <i class="bi bi-trash-fill me-1"></i> @(isRtl ? "حذف" : "Delete")
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="row mb-4">
            <div class="col-12 d-flex justify-content-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center gap-1">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;" 
                               href="/Admin/PromotionCode/Index?page=@(Model.CurrentPage - 1)" aria-label="Previous">
                                <i class="bi bi-chevron-@(isRtl ? "right" : "left")"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;"
                                   href="/Admin/PromotionCode/Index?page=@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;"
                               href="/Admin/PromotionCode/Index?page=@(Model.CurrentPage + 1)" aria-label="Next">
                                <i class="bi bi-chevron-@(isRtl ? "left" : "right")"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const isRtl = '@isRtl' === 'True';
        const deleteLinks = document.querySelectorAll('.js-delete-code');
        deleteLinks.forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                const url = this.href;
                const name = this.dataset.name;
                Swal.fire({
                    title: isRtl ? "هل أنت متأكد؟" : "Are you sure?",
                    text: isRtl ? `هل ترغب في حذف الكود "${name}"؟ لا يمكن التراجع عن هذا الإجراء.` : `Do you want to delete code "${name}"? This action cannot be undone.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: isRtl ? "نعم، احذفه!" : "Yes, delete it!",
                    cancelButtonText: isRtl ? "إلغاء" : "Cancel"
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(url, {
                            method: "POST",
                            headers: {
                                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                            }
                        }).then(response => {
                            if (response.ok) {
                                window.location.reload();
                            } else {
                                Swal.fire({ title: "Error!", text: "Unable to delete the promotion code.", icon: "error" });
                            }
                        });
                    }
                });
            });
        });
    });
</script>
