@using Microsoft.AspNetCore.Localization
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var pageTitle = ViewBag.Title ?? Localizer["AdminDashboard"].Value;
    var reqCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var curCulture = reqCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isRtl = curCulture.StartsWith("ar");
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? "";
}
<!DOCTYPE html>
<html lang="@curCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - @Localizer["AdminDashboard"]</title>

    @if (isRtl)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    }
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    
    <style>
        /* Hangfire Tab Advanced Premium Styling */
        .hangfire-nav-item {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            margin-bottom: 0.75rem;
            background: linear-gradient(135deg, rgba(236, 64, 122, 0.08), rgba(253, 160, 133, 0.08));
            border: 1px solid rgba(236, 64, 122, 0.1);
            backdrop-filter: blur(8px);
            z-index: 1;
        }

        .hangfire-nav-item::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(45deg, #ec407a, #fd8c73, #ff6347, #ec407a);
            background-size: 300% 300%;
            opacity: 0;
            z-index: -1;
            transition: opacity 0.4s ease;
            animation: gradientMove 4s ease infinite;
        }

        .hangfire-nav-item:hover {
            transform: translateY(-2px) translateX(4px);
            box-shadow: 0 8px 24px rgba(236, 64, 122, 0.25);
            border: 1px solid rgba(236, 64, 122, 0.4);
        }

        .hangfire-nav-item:hover::before {
            opacity: 0.15;
        }

        .hangfire-nav-item .hangfire-icon {
            color: #ec407a;
            font-size: 1.2rem;
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .hangfire-nav-item:hover .hangfire-icon {
            transform: scale(1.25) rotate(-10deg);
            color: #d81b60;
            filter: drop-shadow(0 0 6px rgba(236, 64, 122, 0.8));
        }

        .hangfire-nav-item .hangfire-text {
            font-weight: 700;
            background: -webkit-linear-gradient(45deg, #ec407a, #ff7e67);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: all 0.4s ease;
            letter-spacing: 0.3px;
        }

        .hangfire-nav-item:hover .hangfire-text {
            background: -webkit-linear-gradient(45deg, #d81b60, #ff4500);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0px 2px 10px rgba(236, 64, 122, 0.3);
        }

        .hangfire-badge {
            background: linear-gradient(45deg, #ec407a, #ff6347);
            color: white;
            font-size: 0.7rem;
            font-weight: bold;
            padding: 0.35em 0.7em;
            box-shadow: 0 2px 10px rgba(236, 64, 122, 0.5);
            animation: breathe 2s infinite ease-in-out;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        @@keyframes breathe {
            0% { box-shadow: 0 0 0 0 rgba(236, 64, 122, 0.6); transform: scale(1); }
            50% { box-shadow: 0 0 0 8px rgba(236, 64, 122, 0); transform: scale(1.05); }
            100% { box-shadow: 0 0 0 0 rgba(236, 64, 122, 0); transform: scale(1); }
        }
        
        @@keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* System Health Tab Advanced Premium Styling */
        .health-nav-item {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            margin-bottom: 0.75rem;
            background: linear-gradient(135deg, rgba(38, 166, 154, 0.08), rgba(66, 165, 245, 0.08));
            border: 1px solid rgba(38, 166, 154, 0.1);
            backdrop-filter: blur(8px);
            z-index: 1;
        }

        .health-nav-item::after {
            content: '';
            position: absolute;
            top: 50%; left: 1rem;
            width: 20px; height: 20px;
            background: #26a69a;
            border-radius: 50%;
            transform: translateY(-50%) scale(0);
            opacity: 0;
            z-index: -1;
            transition: transform 0.5s ease-out, opacity 0.5s ease-out;
        }

        .health-nav-item:hover::after {
            transform: translateY(-50%) scale(25);
            opacity: 0.1;
        }

        .health-nav-item:hover {
            transform: translateY(-2px) translateX(4px);
            box-shadow: 0 8px 24px rgba(38, 166, 154, 0.25);
            border: 1px solid rgba(38, 166, 154, 0.4);
        }

        .health-nav-item .health-icon {
            color: #26a69a;
            font-size: 1.2rem;
            transition: transform 0.4s ease, color 0.4s ease;
        }

        .health-nav-item:hover .health-icon {
            color: #00897b;
            filter: drop-shadow(0 0 6px rgba(38, 166, 154, 0.8));
            animation: heartbeat 1.2s infinite;
        }

        .health-nav-item .health-text-styled {
            font-weight: 700;
            background: -webkit-linear-gradient(45deg, #26a69a, #42a5f5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: all 0.4s ease;
            letter-spacing: 0.3px;
        }

        .health-nav-item:hover .health-text-styled {
            background: -webkit-linear-gradient(45deg, #00897b, #1e88e5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0px 2px 10px rgba(38, 166, 154, 0.3);
        }

        @@keyframes heartbeat {
            0% { transform: scale(1); }
            15% { transform: scale(1.3); }
            30% { transform: scale(1); }
            45% { transform: scale(1.3); }
            60% { transform: scale(1); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body class="dashboard-body">
    <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken" />
    <div class="dashboard-shell">
        <partial name="~/Areas/Admin/Views/Shared/_Sidebar.cshtml" />

        <div class="dashboard-main">
            <partial name="~/Areas/Admin/Views/Shared/_TopNavbar.cshtml" />

            <main class="dashboard-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.8.0/Chart.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @RenderSection("Scripts", required: false)

    <script>
        (function () {
            const html = document.documentElement;
            const btn  = document.getElementById('themeToggleBtn');
            const icon = document.getElementById('themeIcon');
            function applyTheme(theme) {
                html.setAttribute('data-theme', theme);
                if (icon) {
                    icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
                }
            }
            const saved = localStorage.getItem('shtbly-theme') || 'light';
            applyTheme(saved);
            if (btn) {
                btn.addEventListener('click', function () {
                    const current = html.getAttribute('data-theme') || 'light';
                    const next = current === 'dark' ? 'light' : 'dark';
                    applyTheme(next);
                    localStorage.setItem('shtbly-theme', next);
                });
            }
        })();
    </script>
</body>
</html>
