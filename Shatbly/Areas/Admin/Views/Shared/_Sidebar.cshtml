@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<aside class="sidebar-panel">
    <div class="sidebar-brand">
        <div class="brand-icon">
            <i class="fa-solid fa-layer-group"></i>
        </div>
        <div>
            <h5 class="mb-0">AdminPro</h5>
            <small>@Localizer["ControlCenter"]</small>
        </div>
    </div>

    <nav class="sidebar-nav mt-4">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index"
           class="nav-item @(currentController == "Home" ? "active" : "")">
            <i class="fa-solid fa-house"></i>
            <span>@Localizer["Dashboard"]</span>
        </a>

        <a asp-area="Admin" asp-controller="User" asp-action="Index"
           class="nav-item @(currentController == "User" ? "active" : "")">
            <i class="fa-solid fa-users"></i>
            <span>@Localizer["Users"]</span>
        </a>

        <a asp-area="Admin" asp-controller="Baner" asp-action="Index"
           class="nav-item @(currentController == "Baner" ? "active" : "")">
            <i class="fa-solid fa-calendar-check"></i>
            <span>@Localizer["Banner"]</span>
        </a>

        <a asp-area="Admin" asp-controller="Coupon" asp-action="Index"
           class="nav-item @(currentController == "Coupon" ? "active" : "")">
            <i class="fa-solid fa-ticket"></i>
            <span>@Localizer["Coupons"]</span>
        </a>

        <a asp-area="Admin" asp-controller="Promotion" asp-action="Index"
               class="nav-item @(currentController == "Promotion" ? "active" : "")">
            <i class="fa-solid fa-ticket"></i>
            <span>@Localizer["Promotions"]</span>
        </a>

        <a asp-area="Admin" asp-controller="PromotionCode" asp-action="Index"
               class="nav-item @(currentController == "PromotionCode" ? "active" : "")">
            <i class="fa-solid fa-ticket"></i>
            <span>@Localizer["PromotionCodes"]</span>
        </a>

        <a asp-area="Admin" asp-controller="Booking" asp-action="Index"
           class="nav-item @(currentController == "Booking" ? "active" : "")">
            <i class="fa-solid fa-calendar-check"></i>
            <span>@Localizer["Booking"]</span>
        </a>

        <a asp-area="Admin" asp-controller="ServiceCategory" asp-action="Index"
               class="nav-item @(currentController == "ServiceCategory" ? "active" : "")">
            <i class="fa-solid fa-briefcase"></i>
            <span>@Localizer["Services"]</span>
        </a>

        <a asp-area="Admin" asp-controller="WorkerService" asp-action="Index"
               class="nav-item @(currentController == "WorkerService" ? "active" : "")">
            <i class="fa-solid fa-briefcase"></i>
            <span>@Localizer["WorkerService"]</span>
        </a>

        <a asp-area="Admin" asp-controller="WorkerProfile" asp-action="Index"
               class="nav-item @(currentController == "WorkerProfile" ? "active" : "")">
            <i class="fa-solid fa-briefcase"></i>
            <span>@Localizer["WorkerProfile"]</span>
        </a>

        <a asp-area="Admin" asp-controller="Messages" asp-action="Index"
               class="nav-item @(currentController == "Messages" ? "active" : "")">
            <i class="fa-solid fa-envelope"></i>
            <span>@Localizer["Messages"]</span>
        </a>
        @* Spam to Customer Area *@
        @* <a asp-area="Admin" asp-controller="BookingSystem" asp-action="Create"
           class="nav-item @(currentController == "BookingSystem" ? "active" : "")">
            <i class="fa-solid fa-calendar-check"></i>
            <span>Booking System</span>
        </a> *@

        <a asp-area="Admin" asp-controller="Report" asp-action="Index"
           class="nav-item @(currentController == "Report" ? "active" : "")">
            <i class="fa-solid fa-chart-column"></i>
            <span>@Localizer["Reports"]</span>
        </a>

        <a asp-area="Admin" asp-controller="Withdrawal" asp-action="Index"
           class="nav-item @(currentController == "Withdrawal" ? "active" : "")">
            <i class="fa-solid fa-money-bill-transfer"></i>
            <span>@Localizer["Withdrawals"]</span>
        </a>

        <a asp-area="Admin" asp-controller="Review" asp-action="Index"
           class="nav-item @(currentController == "Review" ? "active" : "")">
            <i class="fa-solid fa-star"></i>
            <span>@Localizer["Reviews"]</span>
        </a>

        <a asp-area="Admin" asp-controller="Dispute" asp-action="Index"
           class="nav-item @(currentController == "Dispute" ? "active" : "")">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>@Localizer["Disputes"]</span>
        </a>

        <a href="/Hangfire" target="_blank"
           class="nav-item hangfire-nav-item @(Context.Request.Path.StartsWithSegments("/Hangfire") ? "active" : "")">
            <i class="fa-solid fa-fire-flame-curved hangfire-icon"></i>
            <span class="hangfire-text">Hangfire Dashboard</span>
            <span class="badge rounded-pill ms-auto hangfire-badge d-flex align-items-center justify-content-center">
                <span class="spinner-grow spinner-grow-sm me-1" role="status" aria-hidden="true" style="width: 0.5rem; height: 0.5rem;"></span>
                Live
            </span>
        </a>

        <a href="/health-ui" target="_blank"
           class="nav-item health-nav-item @(Context.Request.Path.StartsWithSegments("/health-ui") ? "active" : "")"
           id="nav-system-health">
            <i class="fa-solid fa-heart-pulse health-icon"></i>
            <span class="health-text-styled">@Localizer["SystemHealth"]</span>
            <span id="health-alarm-badge" class="badge bg-danger ms-auto d-none pulse-alarm">
                <i class="fa-solid fa-triangle-exclamation"></i> @Localizer["Alert"]
            </span>
        </a>

        <a asp-area="Admin" asp-controller="AdminSettings" asp-action="Index"
           class="nav-item @(currentController == "Setting" ? "active" : "")">
            <i class="fa-solid fa-gear"></i>
            <span>@Localizer["Settings"]</span>
        </a>


        <a href="/Identity/Account/Logout" class="nav-item text-danger">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>@Localizer["Logout"]</span>
        </a>
    </nav>
</aside>