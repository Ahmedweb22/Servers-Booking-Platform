<header class="topbar-panel">
    <div class="topbar-actions">
        <button class="theme-toggle-admin" id="themeToggleBtn" type="button" title="Toggle dark/light mode">
            <i class="bi bi-moon-fill" id="themeIcon"></i>
        </button>
        @await Html.PartialAsync("_LanguageSwitcher")

        <!-- Health Status Indicator -->
        <div id="healthStatusIndicator" class="d-none me-2">
            <a href="/health-ui" class="icon-btn position-relative" style="color: #ef4444;" title="System Health Issues Detected">
                <i class="fa-solid fa-heart-pulse blink-health"></i>
                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="width: 8px; height: 8px; margin-top: 6px; margin-left: -6px;"></span>
            </a>
        </div>

        <div class="dropdown">
            <button class="icon-btn position-relative" type="button" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-regular fa-bell"></i>
                @await Component.InvokeAsync("UnreadNotifications")
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-0" aria-labelledby="notificationsDropdown" style="width: 340px; max-height: 450px; overflow-y: auto;">
                <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-4">
                    <h6 class="mb-0 fw-bold">@Localizer["Notifications"]</h6>
                    <a href="/Admin/Messages" class="text-decoration-none small fw-semibold text-primary">@Localizer["ViewAll"]</a>
                </li>
                <div id="notifications-list" style="max-height: 350px; overflow-y: auto;">
                    <div class="p-4 text-center text-muted">
                        <i class="fa-solid fa-spinner fa-spin fa-2x mb-2 text-primary"></i>
                        <p class="mb-0 small">@Localizer["LoadingNotifications"]</p>
                    </div>
                </div>
            </ul>
        </div>

        <div class="profile-display">
            <div class="profile-avatar">A</div>
            <div class="profile-meta">
                <strong>@Localizer["AdminUser"]</strong>
                <small>@Localizer["SuperAdmin"]</small>
            </div>
        </div>
    </div>
</header>

<style>
    .hover-bg-light {
        transition: background-color 0.2s ease;
    }
    .hover-bg-light:hover {
        background-color: #f8fafc !important;
    }
    .unread-notification {
        background-color: #f0f6ff !important;
    }
    .blink-health {
        animation: pulse-health 1.5s infinite ease-in-out;
        color: #ef4444 !important;
    }
    @@keyframes pulse-health {
        0% {
            transform: scale(1);
            filter: drop-shadow(0 0 0px rgba(239, 68, 68, 0.7));
        }
        70% {
            transform: scale(1.15);
            filter: drop-shadow(0 0 6px rgba(239, 68, 68, 0.7));
        }
        100% {
            transform: scale(1);
            filter: drop-shadow(0 0 0px rgba(239, 68, 68, 0));
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const encodeHtml = function (value) {
            return String(value ?? "").replace(/[&<>"']/g, function (char) {
                return ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                })[char];
            });
        };

        const safePositiveInt = function (value) {
            const parsed = Number.parseInt(value, 10);
            return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : 0;
        };

        const notificationsDropdownBtn = document.getElementById('notificationsDropdown');
        if (notificationsDropdownBtn) {
            notificationsDropdownBtn.addEventListener('show.bs.dropdown', function () {
                const listContainer = document.getElementById('notifications-list');
                
                // Show loading spinner
                listContainer.innerHTML = `
                    <div class="p-4 text-center text-muted">
                        <i class="fa-solid fa-spinner fa-spin fa-2x mb-2 text-primary"></i>
                        <p class="mb-0 small">@Localizer["LoadingNotifications"]</p>
                    </div>
                `;

                fetch('/Customer/Notification/GetNotifications')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Failed to fetch notifications');
                        }
                        return response.json();
                    })
                    .then(data => {
                        listContainer.innerHTML = '';
                        
                        if (!data || data.length === 0) {
                            listContainer.innerHTML = `
                                <div class="p-4 text-center text-muted">
                                    <i class="fa-regular fa-bell-slash fa-2x mb-2"></i>
                                    <p class="mb-0 small">@Localizer["NoNotifications"]</p>
                                </div>
                            `;
                            return;
                        }
                        
                        data.forEach(notification => {
                            const item = document.createElement('div');
                            item.className = `p-3 border-bottom d-flex align-items-start gap-2 hover-bg-light ${notification.isRead ? '' : 'unread-notification'}`;
                            item.style.cursor = 'pointer';
                            const notificationId = safePositiveInt(notification.id);
                            
                            // Handle click to mark read and navigate
                            item.addEventListener('click', function (e) {
                                e.stopPropagation();
                                const navigate = () => {
                                    window.location.href = '/Admin/Messages';
                                };
                                
                                if (!notification.isRead) {
                                    fetch(`/Customer/Notification/MarkAsReadApi/${notificationId}`, {
                                        method: 'POST',
                                        headers: {
                                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                                        }
                                    }).then(() => {
                                        navigate();
                                    }).catch(() => {
                                        navigate();
                                    });
                                } else {
                                    navigate();
                                }
                            });
                            
                            item.innerHTML = `
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold small text-dark text-truncate d-inline-block" style="max-width: 180px;">${encodeHtml(notification.title)}</span>
                                        <span class="text-muted" style="font-size: 0.72rem; flex-shrink: 0;">${encodeHtml(notification.createdAt)}</span>
                                    </div>
                                    <p class="mb-0 text-secondary small" style="font-size: 0.8rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.3;">
                                        ${encodeHtml(notification.message)}
                                    </p>
                                </div>
                                ${!notification.isRead ? '<span class="badge bg-primary rounded-circle p-1 align-self-center" style="width: 8px; height: 8px; flex-shrink: 0; min-width: auto; min-height: auto;"> </span>' : ''}
                            `;
                            listContainer.appendChild(item);
                        });
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        listContainer.innerHTML = `
                            <div class="p-4 text-center text-danger">
                                <i class="fa-solid fa-triangle-exclamation fa-2x mb-2"></i>
                                <p class="mb-0 small">@Localizer["ErrorLoadingNotifications"]</p>
                            </div>
                        `;
                    });
            });
        }

        // Fetch health status and notify admin if unhealthy
        fetch('/health')
            .then(response => {
                if (!response.ok) {
                    throw new Error('Health check request failed');
                }
                return response.json();
            })
            .then(data => {
                if (data && data.status && data.status !== 'Healthy') {
                    // Show health warning indicator in topbar
                    const indicator = document.getElementById('healthStatusIndicator');
                    if (indicator) {
                        indicator.classList.remove('d-none');
                        indicator.setAttribute('title', `@Localizer["HealthWarningTitle"]: ${data.status}`);
                    }
                    
                    // Show sidebar badge if present
                    const sidebarBadge = document.getElementById('health-alarm-badge');
                    if (sidebarBadge) {
                        sidebarBadge.classList.remove('d-none');
                    }

                    // Turn the sidebar link and icon red
                    const navItem = document.getElementById('nav-system-health');
                    if (navItem) {
                        navItem.classList.add('is-unhealthy');
                    }
                    
                    // Show toastr notification once per session
                    if (!sessionStorage.getItem('health_warning_shown')) {
                        toastr.warning(
                            `@Localizer["HealthWarningMessage"]`,
                            `@Localizer["HealthWarningTitle"]`,
                            {
                                timeOut: 10000,
                                closeButton: true,
                                progressBar: true,
                                onclick: function () {
                                    window.location.href = '/health-ui';
                                }
                            }
                        );
                        sessionStorage.setItem('health_warning_shown', 'true');
                    }
                } else {
                    // System is healthy, clear any alert elements/classes
                    const indicator = document.getElementById('healthStatusIndicator');
                    if (indicator) {
                        indicator.classList.add('d-none');
                    }
                    const sidebarBadge = document.getElementById('health-alarm-badge');
                    if (sidebarBadge) {
                        sidebarBadge.classList.add('d-none');
                    }
                    const navItem = document.getElementById('nav-system-health');
                    if (navItem) {
                        navItem.classList.remove('is-unhealthy');
                    }
                }
            })
            .catch(err => console.error('Error fetching health status:', err));
    });
</script>
