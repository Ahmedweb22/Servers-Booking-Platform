@model Shatbly.ViewModels.BookingDetailsViewModel
@using Shatbly.Models

@{
    var isRtl = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture?.UICulture?.Name.StartsWith("ar") ?? false;
    ViewData["Title"] = Localizer["BookingDetailsTitle"];
}

<style>
    html, body {
        overflow: auto !important;
        height: auto !important;
    }

    #map {
        z-index: 1 !important;
    }

    .top-nav, .dropdown-menu {
        z-index: 9999 !important;
    }

    body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, sans-serif;
        background: linear-gradient(180deg, #faf7f2 0%, #f3ece2 100%);
        color: #1f2937;
    }

    .details-shell {
        max-width: 1080px;
        margin: 0 auto;
        padding: 32px 20px 44px;
    }

    .banner, .card {
        background: #fffdf9;
        border: 1px solid #e7d7c8;
        border-radius: 24px;
        box-shadow: 0 16px 45px rgba(51, 37, 24, 0.08);
    }

    .banner {
        padding: 24px;
        margin-bottom: 22px;
    }

        .banner h1 {
            margin: 0 0 8px;
        }

        .banner p {
            margin: 0;
            color: #6b7280;
            line-height: 1.55;
        }

    .notice {
        margin-top: 14px;
        padding: 14px 16px;
        border-radius: 16px;
        background: #eef9f3;
        color: #166534;
    }

    .error {
        background: #fef3f2;
        color: #b42318;
    }

    .grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 20px;
    }

    .card {
        padding: 22px;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .stat {
        padding: 14px;
        border-radius: 18px;
        background: #faf5ee;
        border: 1px solid #e7d7c8;
    }

        .stat label {
            display: block;
            margin-bottom: 6px;
            color: #6b7280;
            font-size: 0.88rem;
        }

    .stack {
        display: grid;
        gap: 16px;
    }

    input, textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border-radius: 16px;
        border: 1px solid #d9c5b2;
        font: inherit;
    }

    textarea {
        min-height: 96px;
        resize: vertical;
    }

    .btn-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn {
        border: 0;
        border-radius: 16px;
        padding: 12px 16px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-primary {
        background: #c26a2d;
        color: #fff;
    }

    .btn-danger {
        background: #b42318;
        color: #fff;
    }

    .muted {
        color: #6b7280;
    }

    @@media (max-width: 860px) {
        .grid, .stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="details-shell">
    <section class="banner">
        <h1>@Localizer["BookingConfirmedHeader", Model.Booking.Id]</h1>
        <p>
            @{
                var svcName = isRtl ? (Model.Booking.Service?.NameAr ?? Model.Booking.Service?.Name ?? "") : (Model.Booking.Service?.Name ?? "");
            }
            @Localizer["BookingServiceDetails", svcName, Model.Booking.Worker?.Name ?? ""]
            @Localizer["ScheduledFor", Model.Booking.ScheduledAt.ToString("dddd, dd MMM yyyy - hh:mm tt")]
        </p>

        @if (TempData["Success"] is string successMessage)
        {
            <div class="notice">@successMessage</div>
        }

        @if (TempData["Error"] is string errorMessage)
        {
            <div class="notice error">@errorMessage</div>
        }
    </section>

    <div class="grid">
        <section class="card stack">
            <div>
                <h2 style="margin-top:0;">@Localizer["BookingDetailsCardTitle"]</h2>
                <p class="muted">@Localizer["BookingDetailsCardSubtitle"]</p>
            </div>

            <div class="stats">
                <div class="stat">
                    <label>@Localizer["StatusLabel"]</label>
                    <strong>@Localizer[Model.Booking.Status.ToString()]</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["BookingTypeLabel"]</label>
                    <strong>@Localizer[Model.Booking.BookingType.ToString()]</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["CustomerLabel"]</label>
                    <strong>@Model.Booking.User?.Name</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["RecurringLabel"]</label>
                    <strong>@Localizer[Model.Booking.RecurrencePattern.ToString()]</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["PaymentLabel"]</label>
                    <strong>@Localizer[Model.Booking.PaymentMethod.ToString()] / @Localizer[Model.Booking.PaymentStatus.ToString()]</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["ConfirmationDeadlineLabel"]</label>
                    <strong>@(Model.Booking.WorkerResponseDeadlineUtc?.ToLocalTime().ToString("dd MMM yyyy - hh:mm tt") ?? Localizer["NotApplicable"].Value)</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["AddressLabel"]</label>
                    <strong>@Model.Booking.AddressLabel</strong>
                    <div class="muted">@Model.Booking.AddressLine</div>
                </div>
                <div class="stat">
                    <label>@Localizer["NotesLabel"]</label>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Booking.Notes) ? Localizer["NoNotes"].Value : Model.Booking.Notes)</strong>
                </div>
            </div>

            <div class="stats">
                <div class="stat">
                    <label>@Localizer["ServicePriceLabel"]</label>
                    <strong>@Localizer["CurrencyFormat", Model.Booking.ServicePrice.ToString("0.00")]</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["ConvenienceFeeLabel"]</label>
                    <strong>@Localizer["CurrencyFormat", Model.Booking.ConvenienceFee.ToString("0.00")]</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["DiscountLabel"]</label>
                    <strong>@Localizer["CurrencyFormat", Model.Booking.DiscountAmount.ToString("0.00")]</strong>
                </div>
                <div class="stat">
                    <label>@Localizer["TotalLabel"]</label>
                    <strong>@Localizer["CurrencyFormat", Model.Booking.TotalPrice.ToString("0.00")]</strong>
                </div>
            </div>
        </section>

        <section class="stack">
            @if (Model.Booking.Status == OrderStatuses.Completed && !string.IsNullOrEmpty(Model.Booking.WorkerId))
            {
                <div class="card text-center" style="border: 2px solid #bbf7d0; background: #f0fdf4; border-radius: 20px; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.08);">
                    <h3 style="margin-top:0; color: #166534; font-weight: 800; font-size: 1.25rem;">
                        <i class="bi bi-stars text-warning me-1"></i> @Localizer["RateServiceTitle"]
                    </h3>
                    
                    @if (Model.HasReview)
                    {
                        <div class="py-2">
                            <span class="badge bg-success rounded-pill px-3 py-2 fs-6 fw-bold">
                                <i class="bi bi-check-circle-fill me-1"></i> @Localizer["RatedSuccessfully"]
                            </span>
                            <p class="text-success fw-semibold mt-3 mb-1" style="font-size: 0.95rem;">@Localizer["RateSuccessMessage"]</p>
                        </div>
                    }
                    else
                    {
                        <p class="muted" style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 18px;">
                            @Localizer["RatePromptMessage"]
                        </p>
                        <a href="/Customer/Review/SubmitReview?OrderId=@Model.Booking.Id&RevieweeId=@Model.Booking.WorkerId" 
                           class="btn w-100 d-flex align-items-center justify-content-center gap-2" 
                           style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 12px; font-weight: 700; padding: 12px; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 8px 16px rgba(16, 185, 129, 0.15);"
                           onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 10px 20px rgba(16, 185, 129, 0.25)';"
                           onmouseout="this.style.transform='none'; this.style.boxShadow='0 8px 16px rgba(16, 185, 129, 0.15)';">
                            <i class="bi bi-star-fill text-warning"></i>
                            <span>@Localizer["RateServiceNow"]</span>
                        </a>
                    }
                </div>
            }

            <div class="card">
                <h3 style="margin-top:0;">@Localizer["RescheduleHeader"]</h3>
                <p class="muted">@Localizer["RescheduleSubtitle"]</p>

                @if (Model.CanReschedule)
                {
                    <form asp-controller="BookingSystem" asp-action="Reschedule" method="post" class="stack">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Booking.Id" />
                        <div>
                            <label for="scheduledAt">@Localizer["NewSlot"]</label>
                            <input id="scheduledAt" name="scheduledAt" type="datetime-local" value="@Model.Booking.ScheduledAt.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="btn-row">
                            <button type="submit" class="btn btn-primary">@Localizer["RescheduleBookingBtn"]</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="muted">@Localizer["CannotReschedule"]</p>
                }
            </div>

            <div class="card">
                <h3 style="margin-top:0;">@Localizer["CancelWithRefundHeader"]</h3>
                <p class="muted">@Html.Raw(string.Format(Localizer["CancelRefundPolicyMessage"].Value, Model.RefundPreview.ToString("0.00")))</p>

                @if (Model.CanCancel)
                {
                    <form asp-controller="BookingSystem" asp-action="Cancel" method="post" class="stack">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Booking.Id" />
                        <div>
                            <label for="cancellationReason">@Localizer["ReasonLabel"]</label>
                            <textarea id="cancellationReason" name="cancellationReason" placeholder="@Localizer["CancellationReasonPlaceholder"]"></textarea>
                        </div>
                        <div class="btn-row">
                            <button type="submit" class="btn btn-danger">@Localizer["CancelBookingBtn"]</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="muted">@Localizer["CannotCancel"]</p>
                }
            </div>

            @if (Model.Booking.Status != OrderStatuses.Cancelled && Model.Booking.Status != OrderStatuses.Rejected)
            {
                <div class="card mt-3 text-center" style="border: 2px solid #fee2e2; background: #fffdfd; border-radius: 20px; box-shadow: 0 10px 25px rgba(220, 38, 38, 0.05);">
                    <h3 style="margin-top:0; color: #991b1b; font-weight: 800; font-size: 1.2rem;">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> @Localizer["FacingIssuesHeader"]
                    </h3>
                    
                    @if (Model.Booking.Booking != null && Model.Booking.Booking.Status == BookingStatus.Disputed)
                    {
                        <div class="py-2">
                            <span class="badge bg-danger rounded-pill px-3 py-2 fs-6 fw-bold">
                                <i class="bi bi-shield-fill-exclamation me-1"></i> @Localizer["UnderReviewDispute"]
                            </span>
                            <p class="text-danger fw-semibold mt-3 mb-1" style="font-size: 0.9rem;">@Localizer["DisputedAlreadyMessage"]</p>
                        </div>
                    }
                    else
                    {
                        <p class="muted" style="font-size: 0.88rem; line-height: 1.5; margin-bottom: 15px;">
                            @Localizer["DisputePromptMessage"]
                        </p>
                        <a href="/Customer/Review/RaiseDispute?id=@Model.Booking.Id" 
                           class="btn w-100 d-flex align-items-center justify-content-center gap-2" 
                           style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; border-radius: 12px; font-weight: 700; padding: 10px; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 8px 16px rgba(220, 38, 38, 0.15);"
                           onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 10px 20px rgba(220, 38, 38, 0.25)';"
                           onmouseout="this.style.transform='none'; this.style.boxShadow='0 8px 16px rgba(220, 38, 38, 0.15)';">
                            <i class="bi bi-shield-fill-exclamation"></i>
                            <span>@Localizer["RaiseDisputeBtn"]</span>
                        </a>
                    }
                </div>
            }

            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

            <div class="card mt-4">
                <input type="hidden" id="bookingIdStore" value="@Model.Booking.Id" />
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-map-marked-alt"></i> @Localizer["LiveTracking"]</h5>
                </div>
                <div class="card-body">
                    <div id="map" style="height: 400px; width: 100%; border-radius: 8px;"></div>
                </div>
            </div>
        </section>
    </div>
</div>
@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // جلب رقم الحجز الحالي من الموديل
        const currentBookingId = document.getElementById("bookingIdStore").value;

        // 1. رسم الخريطة (افتراضياً على إحداثيات مصر/القاهرة مثلاً) وزوم 15
        var map = L.map('map').setView([30.0444, 31.2357], 15);

        // 2. تحميل شكل الخريطة المجاني من OpenStreetMap
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: 'Shatably Live Tracking'
        }).addTo(map);

        // 3. عمل علامة (Marker) افتراضية على الخريطة تمثل الفني
        var workerMarker = L.marker([30.0444, 31.2357]).addTo(map)
        .bindPopup("<b>@Localizer["TechnicianOnTheWay"].Value</b>").openPopup();

        // 4. الاتصال بماسورة التتبع بالـ SignalR
        const clientHubConn = new signalR.HubConnectionBuilder()
        .withUrl("/trackingHub")
        .build();

        clientHubConn.start().then(function () {
        console.log("Connected to Tracking Hub successfully!");

        // بمجرد ما العميل يفتح، بندخله "الجروب" الخاص برقم حكزه عشان يلقط اللوكيشن بتاعه بس
        clientHubConn.invoke("JoinBookingTracking", currentBookingId.toString());
        }).catch(err => console.error(err.toString()));

        // 5. الاستماع لايف -> أول ما الفني يبعت لوكيشن جديد، الدالة دي بتشتغل فوراً
        clientHubConn.on("ReceiveLocation", function (latitude, longitude) {
        console.log(`Received Worker Location -> Lat: ${latitude}, Lng: ${longitude}`);

        var newCoords = new L.LatLng(latitude, longitude);

        workerMarker.setLatLng(newCoords); // تحريك أيقونة الفني للمكان الجديد
        map.panTo(newCoords);              // نقل مركز الخريطة مع حركة الفني
        });
    </script>
}

