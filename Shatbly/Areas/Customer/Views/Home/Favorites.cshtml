@model IEnumerable<WorkerProfile>
<div class="container my-4">
	<h2 class="mb-4">المفضلة</h2>
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle-fill fs-1 mb-2"></i>
            <h5 class="fw-bold mb-0">لا يوجد فنيين متاحين</h5>
            <p class="text-muted fw-semibold mb-0">يرجى تغيير الفلاتر أو المحاولة لاحقًا.</p>
        </div>
    }
    else
    {

        <!-- Normal Worker Card 1 -->
        @foreach (var worker in Model)
        {
            <div class="worker-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="d-flex gap-3">
                        <div class="avatar-container">
                            <img src="https://images.unsplash.com/photo-1506803682981-6e718a9dd3ee?q=80&w=200&auto=format&fit=crop" class="worker-avatar" alt="Worker">
                            <span class="online-dot" style="background-color: #f59e0b;"></span> <!-- Busy but available soon -->
                        </div>
                        <div>
                            <h6 class="fw-800 mb-1 fs-5 d-flex align-items-center">
                                @worker.User.FName @worker.User.LName
                                <i class="bi bi-patch-check-fill verified-icon ms-1"></i>
                            </h6>
                            <p class="text-muted fw-semibold small mb-2">@worker.WorkerServices.Category.Name</p>
                            <div class="d-flex gap-2">
                                <span class="tag"><i class="bi bi-house-gear me-1"></i> سمارت هوم</span>
                                <span class="tag"><i class="bi bi-geo-alt-fill me-1"></i> يبعد 3.1 كم</span>
                            </div>
                        </div>
                    </div>
                    <form method="post" action="/Customer/Home/ToggleFavorite">
                        <input type="hidden" name="workerId" value="@worker.Id" />
                        <button class="btn btn-danger btn-sm" type="submit">
                        ازاله من المفضله
                        </button>
                    </form>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div class="price-tag">200 <span class="fs-6 text-muted fw-semibold">ج.م / معاينة</span></div>
                    <button class="btn-book bg-light text-dark border">التفاصيل</button>
                </div>

                <div class="stats-row">
                    <div class="stat-item"><div class="rating-box"><i class="bi bi-star-fill"></i> 4.7</div></div>
                    <div class="stat-item"><i class="bi bi-check-circle-fill text-success fs-6"></i> 89 مهمة مكتملة</div>
                </div>
            </div>
        }
    }
</div>