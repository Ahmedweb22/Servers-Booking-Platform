@model CustomerIndexVM

    <!-- 2. Advanced Filter Bar -->
    <nav class="filter-bar">
        <div class="d-flex align-items-center gap-3 flex-grow-1">
            <div class="search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" class="search-input" placeholder="ابحث عن فني، تخصص، أو خدمة...">
            </div>
            
            <div class="category-chips">
            <div class="chip active"><a href ="/Customer/Home/Index"><i class="bi bi-grid-fill"></i> الكل</a></div>
			@foreach (var category in Model.Categories)
			{
                <div class="chip"><a href="/Customer/Home/Index?categoryId=@category.Id"><i class="bi bi-droplet-fill text-info"></i> @category.Name</a></div>
            }  
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 ms-3 border-start ps-3">
            <select class="filter-select">
                <option selected disabled>المكان</option>
                <option>الإسكندرية - سموحة</option>
                <option>الإسكندرية - ميامي</option>
                <option>القاهرة - التجمع</option>
            </select>
            <button class="btn btn-dark fw-bold rounded-3 px-3 py-2"><i class="bi bi-sliders me-1"></i> فلتر</button>
        </div>
    </nav>

    <!-- 3. Main Content -->
    <div class="main-layout">
        
        <!-- Sidebar: Workers List -->
        <aside class="workers-sidebar">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <h5 class="mb-0">فنيين متاحين في منطقتك</h5>
                <span class="text-muted fw-bold small">124 نتيجة</span>
            </div>

		@if (!Model.Workers.Any())
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle-fill fs-1 mb-2"></i>
                <h5 class="fw-bold mb-0">لا يوجد فنيين متاحين</h5>
                <p class="text-muted fw-semibold mb-0">يرجى تغيير الفلاتر أو المحاولة لاحقًا.</p>
            </div>
        }
        else
        {

            <!-- Normal Worker Card 1 -->
			@foreach (var worker in Model.Workers)
            {
                <div class="worker-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex gap-3">
                            <div class="avatar-container">
                                <img src="https://images.unsplash.com/photo-1506803682981-6e718a9dd3ee?q=80&w=200&auto=format&fit=crop" class="worker-avatar" alt="Worker">
                                <span class="online-dot" style="background-color: #f59e0b;"></span> <!-- Busy but available soon -->
                            </div>
                            <div>
                                <h6 class="fw-800 mb-1 fs-5 d-flex align-items-center">
									@(worker.User?.FName) @(worker.User?.LName)
                                    <i class="bi bi-patch-check-fill verified-icon ms-1"></i>
                                </h6>
                                <p class="text-muted fw-semibold small mb-2">@(worker.WorkerServices?.Category?.Name ?? "غير محدد")</p>
                                <div class="d-flex gap-2">
                                    <span class="tag"><i class="bi bi-house-gear me-1"></i> @(worker.User?.Addresses?.FirstOrDefault()?.District ?? "حي غير محدد")</span>
                                    <span class="tag"><i class="bi bi-geo-alt-fill me-1"></i> @(worker.User?.Addresses?.FirstOrDefault()?.City ?? "مدينة غير محددة")</span>
                                </div>
                            </div>
                        </div>
                        		<form method="post" action="/Customer/Home/ToggleFavorite">
							<input type="hidden" name="workerId" value="@worker.Id" />
                        <button class="fav-btn @(Model.FavoriteWorkerIds.Contains(worker.Id) ? "active" : "")" type="submit">
                            @if(Model.FavoriteWorkerIds.Contains(worker.Id))
                            {
                                <i class="bi bi-heart-fill"></i>
                            }
								else
								{
									<i class="bi bi-heart"></i>
								}
                            </button>
                        </form>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="price-tag">200 <span class="fs-6 text-muted fw-semibold">ج.م / معاينة</span></div>
                        <div class="d-flex gap-2">
                            @{
                                var addr = worker.User?.Addresses?.FirstOrDefault();
                                var lat = addr?.Lat ?? 30.0444; // Default to Cairo
                                var lng = addr?.Lng ?? 31.2357;
                            }
                            <button class="btn btn-outline-primary rounded-3 px-3 py-1 fw-bold small" onclick="showWorkerOnMap(@lat, @lng, '@(worker.User?.FName) @(worker.User?.LName)')">
                                <i class="bi bi-geo-alt-fill"></i> تحديد الموقع
                            </button>
                            <button class="btn-book">التفاصيل</button>
                        </div>
                    </div>

                    <div class="stats-row">
                        <div class="stat-item"><div class="rating-box"><i class="bi bi-star-fill"></i> 4.7</div></div>
                        <div class="stat-item"><i class="bi bi-check-circle-fill text-success fs-6"></i> 89 مهمة مكتملة</div>
                    </div>
                </div>
            }
        }
        </aside>

        <!-- Main Map Area -->
        <main id="map-container">
            <div class="map-overlay">
                <div class="map-badge">
                    <i class="bi bi-geo-alt-fill fs-1 text-primary mb-2 d-block"></i>
                    <h4 class="fw-800 mb-1">خريطة الفنيين التفاعلية</h4>
                    <p class="text-muted fw-semibold mb-0">جاري تحميل الخريطة والمواقع المباشرة للفنيين...</p>
                </div>
            </div>
            
            <!-- Emergency Button -->
            <button class="fab-emergency">
                <i class="bi bi-exclamation-triangle-fill"></i>
                طلب طوارئ سريع
            </button>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        var map;
        var marker;

        function initMap() {
            // Initialize map centered on Egypt
            map = L.map('map-container').setView([26.8206, 30.8025], 6);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            // Remove overlay once map is loaded
            document.querySelector('.map-overlay').style.display = 'none';
        }

        function showWorkerOnMap(lat, lng, name) {
            if (!map) initMap();

            // Clear existing marker
            if (marker) {
                map.removeLayer(marker);
            }

            // Move view to worker
            map.setView([lat, lng], 15);

            // Add marker
            marker = L.marker([lat, lng]).addTo(map)
                .bindPopup("<b>" + name + "</b><br>موقع الفني المعتمد")
                .openPopup();
        }

        // Auto init map on first interaction or page load if needed
        window.onload = function() {
            initMap();
        };
    </script>
}
