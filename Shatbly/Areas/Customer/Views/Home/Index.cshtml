@model CustomerIndexVM

    <!-- 2. Advanced Filter Bar -->
    <nav class="filter-bar">
        <div class="d-flex align-items-center gap-3 flex-grow-1">

            <div class="search-wrapper">
                      <form asp-action="Index" method="get">
                <i class="bi bi-search"></i>
                <input type="text" class="search-input" placeholder="ابحث عن فني، تخصص، أو خدمة..." value="@ViewData["SearchString"]" name="searchString" />
                <button type="submit" class="search-btn">بحث</button>
</form>
            </div>
                 
            <div class="category-chips">
            <div class="chip active"><a href ="/Customer/Home/Index"><i class="bi bi-grid-fill"></i> الكل</a></div>
			@foreach (var category in Model.Categories)
			{
                <div class="chip"><a href="/Customer/Home/Index?categoryId=@category.Id"><i class="bi bi-droplet-fill text-info"></i> @category.Name</a></div>
            }  
            </div>
        </div>

        <div class="category-chips">
            <div class="chip active"><a href="/Customer/Home/Index"><i class="bi bi-grid-fill"></i> الكل</a></div>

            <!-- ✅ تعديل: التحقق من أن الأقسام موجودة قبل الدوران عليها -->
            @if (Model.Categories != null)
            {
                @foreach (var category in Model.Categories)
                {
                    <div class="chip"><a href="/Customer/Home/Index?categoryId=@category.Id"><i class="bi bi-droplet-fill text-info"></i> @category.Name</a></div>
                }
            }
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 ms-3 border-start ps-3">
        <select class="filter-select">
            <option selected disabled>المكان</option>
            <option>الإسكندرية - سموحة</option>
            <option>الإسكندرية - ميامي</option>
            <option>القاهرة - التجمع</option>
        </select>
        <button class="btn btn-dark fw-bold rounded-3 px-3 py-2"><i class="bi bi-sliders me-1"></i> فلتر</button>
    </div>
</nav>

<!-- 3. Main Content -->
<div class="main-layout">

    <!-- Sidebar: Workers List -->
    <aside class="workers-sidebar">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h5 class="mb-0">فنيين متاحين في منطقتك</h5>
            <!-- يمكنك لاحقاً جعل هذا الرقم ديناميكي باستخدام Model.Workers?.Count() -->
            <span class="text-muted fw-bold small">@(Model.Workers?.Count() ?? 0) نتيجة</span>
        </div>

        <!-- ✅ تعديل: حماية التحقق من الفنيين إذا كانت القائمة فارغة -->
        @if (Model.Workers == null || !Model.Workers.Any())
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle-fill fs-1 mb-2"></i>
                <h5 class="fw-bold mb-0">لا يوجد فنيين متاحين</h5>
                <p class="text-muted fw-semibold mb-0">يرجى تغيير الفلاتر أو المحاولة لاحقًا.</p>
            </div>
        }
        else
        {
            <!-- Normal Worker Card 1 -->
            @foreach (var worker in Model.Workers)
            {
                <div class="worker-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex gap-3">
                            <div class="avatar-container">
                                <img src="https://images.unsplash.com/photo-1506803682981-6e718a9dd3ee?q=80&w=200&auto=format&fit=crop" class="worker-avatar" alt="Worker">
                                <span class="online-dot" style="background-color: #f59e0b;"></span> <!-- Busy but available soon -->
                            </div>
                            <div>
                                <!-- ✅ تعديل: استخدام ؟ لمنع الخطأ إذا كان الـ User فارغاً -->
                                <h6 class="fw-800 mb-1 fs-5 d-flex align-items-center">
                                    @(worker.User?.FName) @(worker.User?.LName)
                                    <i class="bi bi-patch-check-fill verified-icon ms-1"></i>
                                </h6>
                                <!-- ✅ تعديل: استخدام ؟ لمنع الخطأ واستخدام نص بديل في حال لم يكن هناك تخصص -->
                                <p class="text-muted fw-semibold small mb-2">@(worker.WorkerServices?.Category?.Name ?? "غير محدد")</p>
                                <div class="d-flex gap-2">
                                    <span class="tag"><i class="bi bi-house-gear me-1"></i> سمارت هوم</span>
                                    <span class="tag"><i class="bi bi-geo-alt-fill me-1"></i> يبعد 3.1 كم</span>
                                </div>
                            </div>
                        </div>
                        <form method="post" action="/Customer/Home/ToggleFavorite">
                            <input type="hidden" name="workerId" value="@worker.Id" />
                            <button class="fav-btn" type="submit">
                                <!-- ✅ تعديل: التحقق من أن قائمة المفضلة ليست فارغة قبل استخدام Contains -->
                                @if (Model.FavoriteWorkerIds != null && Model.FavoriteWorkerIds.Contains(worker.Id))
                                {
                                    <i class="bi bi-heart-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-heart"></i>
                                }
                            </button>
                        </form>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="price-tag">200 <span class="fs-6 text-muted fw-semibold">ج.م / معاينة</span></div>
                        <button class="btn-book bg-light text-dark border">التفاصيل</button>
                    </div>

                    <div class="stats-row">
                        <div class="stat-item"><div class="rating-box"><i class="bi bi-star-fill"></i> 4.7</div></div>
                        <div class="stat-item"><i class="bi bi-check-circle-fill text-success fs-6"></i> 89 مهمة مكتملة</div>
                    </div>
                </div>
            }
        }
    </aside>

    <!-- Main Map Area -->
    <main id="map-container">
        <div class="map-overlay">
            <div class="map-badge">
                <i class="bi bi-geo-alt-fill fs-1 text-primary mb-2 d-block"></i>
                <h4 class="fw-800 mb-1">خريطة الفنيين التفاعلية</h4>
                <p class="text-muted fw-semibold mb-0">جاري تحميل الخريطة والمواقع المباشرة للفنيين...</p>
            </div>
        </div>

        <!-- Emergency Button -->
        <button class="fab-emergency">
            <i class="bi bi-exclamation-triangle-fill"></i>
            طلب طوارئ سريع
        </button>
    </main>
</div>