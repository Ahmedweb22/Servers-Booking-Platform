            govSelect.appendChild(opt);
        });

        // If a city was already selected, populate districts
        if (selectedCity && locationData[selectedCity]) {
            distSelect.disabled = false;
            distSelect.innerHTML = '<option value="" selected disabled>' + '@Localizer["SelectDistrictLabel"]' + '</option>';
            locationData[selectedCity].forEach(function(dist) {
                var opt = document.createElement('option');
                opt.value = dist;
                opt.textContent = dist;
                if (dist === selectedDistrict) opt.selected = true;
                distSelect.appendChild(opt);
            });
        }

        // When governorate changes, populate districts
        govSelect.addEventListener('change', function() {
            var gov = this.value;
            distSelect.disabled = false;
            distSelect.innerHTML = '<option value="" selected disabled>' + '@Localizer["SelectDistrictLabel"]' + '</option>';
            // Add "All districts" option
            var allOpt = document.createElement('option');
            allOpt.value = '__all__';
            allOpt.textContent = '@Localizer["AllDistricts"]';
            distSelect.appendChild(allOpt);

            if (locationData[gov]) {
                locationData[gov].forEach(function(dist) {
                    var opt = document.createElement('option');
                    opt.value = dist;
                    opt.textContent = dist;
                    distSelect.appendChild(opt);
                });
            }
        });

        // Filter button click
        document.getElementById('locationFilterBtn').addEventListener('click', function() {
            var city = govSelect.value;
            var district = distSelect.value;
            if (!city) {
                // Highlight the governorate select
                govSelect.style.borderColor = '#ef4444';
                govSelect.style.boxShadow = '0 0 0 3px rgba(239,68,68,0.15)';
                setTimeout(function() {
                    govSelect.style.borderColor = '';
                    govSelect.style.boxShadow = '';
                }, 1500);
                return;
            }
            var url = '/Customer/Home/Index?city=' + encodeURIComponent(city);
            if (district && district !== '__all__') {
                url += '&district=' + encodeURIComponent(district);
            }
            window.location.href = url;
        });


            const slides = document.querySelectorAll('.smart-banner-item');
        const dots = document.querySelectorAll('.smart-dot');

        const nextBtn = document.getElementById('bannerNext');
        const prevBtn = document.getElementById('bannerPrev');

        let current = 0;

        function showSlide(index) {

            slides.forEach(slide =>
                slide.classList.remove('active'));

            dots.forEach(dot =>
                dot.classList.remove('active'));

            slides[index].classList.add('active');

            dots[index].classList.add('active');
        }

        nextBtn.addEventListener('click', () => {

            current++;

            if (current >= slides.length)
                current = 0;

            showSlide(current);
        });

        prevBtn.addEventListener('click', () => {

            current--;

            if (current < 0)
                current = slides.length - 1;

            showSlide(current);
        });

        setInterval(() => {

            current++;

            if (current >= slides.length)
                current = 0;

            showSlide(current);

        }, 5000);

    </script>
}
