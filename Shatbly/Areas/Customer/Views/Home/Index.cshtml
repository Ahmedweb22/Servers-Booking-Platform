@model CustomerIndexVM

<!-- 2. Advanced Filter Bar -->
<nav class="filter-bar">
    <div class="d-flex align-items-center gap-3 flex-grow-1 flex-wrap">

        <!-- 🔍 البحث -->
        <div class="search-wrapper">
            <form asp-action="Index" method="get" id="filterForm">
                <i class="bi bi-search"></i>
                <input type="text" class="search-input" placeholder="ابحث عن فني، تخصص، أو خدمة..." value="@ViewData["SearchString"]" name="searchString" />
                <button type="submit" class="search-btn">بحث</button>
            </form>
        </div>

        <!-- 📂 تصنيف الخدمات -->
        <div class="filter-group">
            <span class="filter-label"><i class="bi bi-layers me-1"></i> التصنيف:</span>
            <div class="category-chips">
                <div class="chip @(ViewData["SelectedCategory"] == null ? "active" : "")">
                    <a href="/Customer/Home/Index"><i class="bi bi-grid-fill"></i> الكل</a>
                </div>
                @if (Model.Categories != null)
                {
                    @foreach (var category in Model.Categories)
                    {
                        <div class="chip @(ViewData["SelectedCategory"]?.ToString() == category.Id.ToString() ? "active" : "")">
                            <a href="/Customer/Home/Index?categoryId=@category.Id"><i class="bi bi-droplet-fill text-info"></i> @category.NameAr</a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- 📍 فلتر الموقع: محافظة ← منطقة -->
    <div class="d-flex align-items-center gap-2 ms-3 border-start ps-3">
        <div class="location-filter-group">
            <span class="filter-label"><i class="bi bi-geo-alt me-1"></i> الموقع:</span>
            <div class="d-flex align-items-center gap-2">
                <select class="filter-select" id="governorateSelect">
                    <option value="" selected disabled>اختر المحافظة</option>
                </select>
                <select class="filter-select" id="districtSelect" disabled>
                    <option value="" selected disabled>اختر المنطقة</option>
                </select>
                <button class="btn btn-dark fw-bold rounded-3 px-3 py-2" id="locationFilterBtn" type="button">
                    <i class="bi bi-sliders me-1"></i> فلتر
                </button>
                @if (ViewData["SelectedCity"] != null || ViewData["SelectedDistrict"] != null)
                {
                    <a href="/Customer/Home/Index" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-bold" title="إزالة فلتر الموقع">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</nav>

<!-- 3. Main Content -->
<div class="main-layout">

    <!-- Sidebar: Workers List -->
    <aside class="workers-sidebar">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h5 class="mb-0">فنيين متاحين في منطقتك</h5>
            <span class="text-muted fw-bold small">@(Model.Workers?.Count() ?? 0) نتيجة</span>
        </div>

        @if (Model.Workers == null || !Model.Workers.Any())
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle-fill fs-1 mb-2"></i>
                <h5 class="fw-bold mb-0">لا يوجد فنيين متاحين</h5>
                <p class="text-muted fw-semibold mb-0">يرجى تغيير الفلاتر أو المحاولة لاحقًا.</p>
            </div>
        }
        else
        {
            @foreach (var worker in Model.Workers)
            {
                <div class="worker-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex gap-3">
                            <div class="avatar-container">
                                <img src="https://images.unsplash.com/photo-1506803682981-6e718a9dd3ee?q=80&w=200&auto=format&fit=crop" class="worker-avatar" alt="Worker">
                                <span class="online-dot" style="background-color: #f59e0b;"></span>
                            </div>
                            <div>
                                <h6 class="fw-800 mb-1 fs-5 d-flex align-items-center">
									@(worker.User?.FName) @(worker.User?.LName)
                                    <i class="bi bi-patch-check-fill verified-icon ms-1"></i>
                                </h6>
                                <p class="text-muted fw-semibold small mb-2">@(worker.WorkerServices?.Category?.Name ?? "غير محدد")</p>
                                <div class="d-flex gap-2">
                                    <span class="tag"><i class="bi bi-house-gear me-1"></i> @(worker.User?.Addresses?.FirstOrDefault()?.District ?? "حي غير محدد")</span>
                                    <span class="tag"><i class="bi bi-geo-alt-fill me-1"></i> @(worker.User?.Addresses?.FirstOrDefault()?.City ?? "مدينة غير محددة")</span>
                                </div>
                            </div>
                        </div>
                        <form method="post" action="/Customer/Home/ToggleFavorite">
						    <input type="hidden" name="workerId" value="@worker.Id" />
                            <button class="fav-btn @(Model.FavoriteWorkerIds.Contains(worker.Id) ? "active" : "")" type="submit">
                                @if(Model.FavoriteWorkerIds.Contains(worker.Id))
                                {
                                    <i class="bi bi-heart-fill"></i>
                                }
							    else
							    {
								    <i class="bi bi-heart"></i>
							    }
                            </button>
                        </form>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="price-tag">200 <span class="fs-6 text-muted fw-semibold">ج.م / معاينة</span></div>
                        <div class="d-flex gap-2">
                            @{
                                var addr = worker.User?.Addresses?.FirstOrDefault();
                                var lat = addr?.Lat ?? 30.0444;
                                var lng = addr?.Lng ?? 31.2357;
                            }
                            <button class="btn btn-outline-primary rounded-3 px-3 py-1 fw-bold small" onclick="showWorkerOnMap(@lat, @lng, '@(worker.User?.FName) @(worker.User?.LName)')">
                                <i class="bi bi-geo-alt-fill"></i> تحديد الموقع
                            </button>
                            <a href="/Customer/Home/WorkerDetails/@worker.Id" class="btn-book">التفاصيل</a>
                        </div>
                    </div>

                    <div class="stats-row">
                        <div class="stat-item"><div class="rating-box"><i class="bi bi-star-fill"></i> 4.7</div></div>
                        <div class="stat-item"><i class="bi bi-check-circle-fill text-success fs-6"></i> 89 مهمة مكتملة</div>
                    </div>
                </div>
            }
        }
    </aside>

    <!-- Main Map Area -->
    <main id="map-container">
        <div class="map-overlay">
            <div class="map-badge">
                <i class="bi bi-geo-alt-fill fs-1 text-primary mb-2 d-block"></i>
                <h4 class="fw-800 mb-1">خريطة الفنيين التفاعلية</h4>
                <p class="text-muted fw-semibold mb-0">جاري تحميل الخريطة والمواقع المباشرة للفنيين...</p>
            </div>
            
            <!-- Emergency Button -->
            <button class="fab-emergency">
                <i class="bi bi-exclamation-triangle-fill"></i>
                طلب طوارئ سريع
            </button>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        var map;
        var marker;

        function initMap() {
            map = L.map('map-container').setView([26.8206, 30.8025], 6);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            document.querySelector('.map-overlay').style.display = 'none';
        }

        function showWorkerOnMap(lat, lng, name) {
            if (!map) initMap();

            if (marker) {
                map.removeLayer(marker);
            }

            map.setView([lat, lng], 15);

            marker = L.marker([lat, lng]).addTo(map)
                .bindPopup("<b>" + name + "</b><br>موقع الفني المعتمد")
                .openPopup();
        }

        window.onload = function() {
            initMap();
        };

        // ===== Cascading Location Filter =====
        // Egypt governorates and their districts/places
        var locationData = {
            "القاهرة": ["المعادي", "التجمع الخامس", "مدينة نصر", "مصر الجديدة", "وسط البلد", "الزمالك", "المقطم", "عين شمس", "شبرا", "حلوان"],
            "الإسكندرية": ["سموحة", "ميامي", "سيدي جابر", "المنتزه", "العجمي", "محرم بك", "كليوباترا", "ستانلي", "الشاطبي", "لوران"],
            "الجيزة": ["الدقي", "المهندسين", "الهرم", "فيصل", "6 أكتوبر", "الشيخ زايد", "أكتوبر", "العمرانية", "البدرشين", "الحوامدية"],
            "القليوبية": ["شبرا الخيمة", "بنها", "قليوب", "القناطر الخيرية", "طوخ", "كفر شكر"],
            "الشرقية": ["الزقازيق", "العاشر من رمضان", "ههيا", "بلبيس", "فاقوس", "أبو حماد"],
            "الدقهلية": ["المنصورة", "طلخا", "ميت غمر", "أجا", "دكرنس", "السنبلاوين"],
            "الغربية": ["طنطا", "المحلة الكبرى", "كفر الزيات", "زفتى", "السنطة", "قطور"],
            "المنوفية": ["شبين الكوم", "منوف", "أشمون", "الشهداء", "قويسنا", "تلا"],
            "البحيرة": ["دمنهور", "كفر الدوار", "رشيد", "إيتاي البارود", "أبو حمص", "المحمودية"],
            "كفر الشيخ": ["كفر الشيخ", "دسوق", "بلطيم", "فوه", "سيدي سالم", "الحامول"],
            "دمياط": ["دمياط", "رأس البر", "فارسكور", "كفر سعد", "الزرقا"],
            "بورسعيد": ["حي الشرق", "حي العرب", "حي المناخ", "حي الضواحي", "حي الزهور"],
            "السويس": ["حي الأربعين", "حي عتاقة", "حي السويس", "الجناين", "فيصل"],
            "الإسماعيلية": ["الإسماعيلية", "فايد", "القنطرة شرق", "التل الكبير", "أبو صوير"],
            "أسيوط": ["أسيوط", "ديروط", "منفلوط", "القوصية", "أبنوب", "الفتح"],
            "سوهاج": ["سوهاج", "أخميم", "طما", "جرجا", "المراغة", "البلينا"],
            "قنا": ["قنا", "نجع حمادي", "قوص", "دشنا", "فرشوط", "أبو تشت"],
            "الأقصر": ["الأقصر", "إسنا", "أرمنت", "الطود", "القرنة", "البياضية"],
            "أسوان": ["أسوان", "كوم أمبو", "إدفو", "دراو", "نصر النوبة"],
            "المنيا": ["المنيا", "ملوي", "بني مزار", "أبو قرقاص", "سمالوط", "مغاغة"],
            "بني سويف": ["بني سويف", "الفشن", "ببا", "إهناسيا", "ناصر", "الواسطى"],
            "الفيوم": ["الفيوم", "طامية", "سنورس", "إطسا", "يوسف الصديق"],
            "البحر الأحمر": ["الغردقة", "سفاجا", "القصير", "مرسى علم", "رأس غارب"],
            "الوادي الجديد": ["الخارجة", "الداخلة", "الفرافرة", "باريس", "بلاط"],
            "مطروح": ["مرسى مطروح", "الحمام", "العلمين", "الضبعة", "سيوة", "السلوم"],
            "شمال سيناء": ["العريش", "الشيخ زويد", "رفح", "بئر العبد", "الحسنة"],
            "جنوب سيناء": ["شرم الشيخ", "دهب", "نويبع", "طابا", "سانت كاترين", "الطور"]
        };

        var selectedCity = '@(ViewData["SelectedCity"] ?? "")';
        var selectedDistrict = '@(ViewData["SelectedDistrict"] ?? "")';

        var govSelect = document.getElementById('governorateSelect');
        var distSelect = document.getElementById('districtSelect');

        // Populate governorates
        Object.keys(locationData).forEach(function(gov) {
            var opt = document.createElement('option');
            opt.value = gov;
            opt.textContent = gov;
            if (gov === selectedCity) opt.selected = true;
            govSelect.appendChild(opt);
        });

        // If a city was already selected, populate districts
        if (selectedCity && locationData[selectedCity]) {
            distSelect.disabled = false;
            distSelect.innerHTML = '<option value="" selected disabled>اختر المنطقة</option>';
            locationData[selectedCity].forEach(function(dist) {
                var opt = document.createElement('option');
                opt.value = dist;
                opt.textContent = dist;
                if (dist === selectedDistrict) opt.selected = true;
                distSelect.appendChild(opt);
            });
        }

        // When governorate changes, populate districts
        govSelect.addEventListener('change', function() {
            var gov = this.value;
            distSelect.disabled = false;
            distSelect.innerHTML = '<option value="" selected disabled>اختر المنطقة</option>';
            // Add "All districts" option
            var allOpt = document.createElement('option');
            allOpt.value = '__all__';
            allOpt.textContent = 'كل المناطق';
            distSelect.appendChild(allOpt);

            if (locationData[gov]) {
                locationData[gov].forEach(function(dist) {
                    var opt = document.createElement('option');
                    opt.value = dist;
                    opt.textContent = dist;
                    distSelect.appendChild(opt);
                });
            }
        });

        // Filter button click
        document.getElementById('locationFilterBtn').addEventListener('click', function() {
            var city = govSelect.value;
            var district = distSelect.value;
            if (!city) {
                // Highlight the governorate select
                govSelect.style.borderColor = '#ef4444';
                govSelect.style.boxShadow = '0 0 0 3px rgba(239,68,68,0.15)';
                setTimeout(function() {
                    govSelect.style.borderColor = '';
                    govSelect.style.boxShadow = '';
                }, 1500);
                return;
            }
            var url = '/Customer/Home/Index?city=' + encodeURIComponent(city);
            if (district && district !== '__all__') {
                url += '&district=' + encodeURIComponent(district);
            }
            window.location.href = url;
        });
    </script>
}
