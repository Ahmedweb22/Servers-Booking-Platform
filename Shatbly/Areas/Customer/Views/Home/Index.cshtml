@model CustomerIndexVM

@{
    var isRtl = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture?.UICulture?.Name.StartsWith("ar") ?? false;
    ViewData["Title"] = Localizer["PageTitle"];
}

<style>
    /* =========================
       SMART BANNER
    ========================= */

    .smart-banner {
        position: relative;
        width: 100%;
        height: 280px;
        overflow: hidden;
        background: linear-gradient( 135deg, #0f172a, #1e293b );
        border-radius: 0 0 24px 24px;
        margin-bottom: 18px;
    }

    /* Slider */

    .smart-banner-slider {
        position: relative;
        width: 100%;
        height: 100%;
    }

    /* Item */

    .smart-banner-item {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        transition: 0.6s;
    }

        .smart-banner-item.active {
            opacity: 1;
            visibility: visible;
            z-index: 2;
        }

    /* Content */

    .smart-banner-content {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 40px 80px;
        gap: 40px;
    }

    /* Text */

    .smart-banner-text {
        max-width: 500px;
        color: white;
        text-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    .smart-badge {
        display: inline-block;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.15);
        padding: 8px 16px;
        border-radius: 999px;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .smart-banner-text h2 {
        font-size: 2.3rem;
        font-weight: 900;
        line-height: 1.3;
        margin-bottom: 16px;
        color: white;
        text-shadow: 0 4px 14px rgba(0,0,0,0.35);
    }

    .smart-banner-text p {
        color: rgba(255,255,255,0.92);
        line-height: 1.9;
        margin-bottom: 22px;
        font-weight: 500;
    }

    /* Button */

    .smart-banner-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        background: #2563eb;
        color: white;
        text-decoration: none;
        border-radius: 14px;
        font-weight: 700;
        transition: 0.3s;
    }

        .smart-banner-btn:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
            color: white;
        }

    /* Image */

    .smart-banner-image {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .smart-banner-image img {
            max-width: 100%;
            max-height: 220px;
            object-fit: contain;
            filter: drop-shadow(0 10px 25px rgba(0,0,0,0.25));
        }

    /* Arrows */

    .smart-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
        height: 48px;
        border: none;
        border-radius: 50%;
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(8px);
        color: white;
        z-index: 10;
        cursor: pointer;
        transition: 0.3s;
    }

        .smart-arrow:hover {
            background: rgba(255,255,255,0.22);
        }

        .smart-arrow.prev {
            left: 18px;
        }

        .smart-arrow.next {
            right: 18px;
        }

    /* Dots */

    .smart-dots {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
        z-index: 10;
    }

    .smart-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255,255,255,0.35);
        transition: 0.3s;
    }

        .smart-dot.active {
            width: 28px;
            border-radius: 999px;
            background: white;
        }

    /* Responsive */

    @@media(max - width:768px) {

        .smart-banner {
            height: auto;
        }

        .smart-banner-content {
            flex-direction: column;
            text-align: center;
            padding: 35px 20px;
        }

        .smart-banner-text h2 {
            font-size: 1.7rem;
        }

        .smart-banner-image img {
            max-height: 160px;
        }
    }
</style>
<!-- 2. Advanced Filter Bar -->
<nav class="filter-bar">
    <div class="d-flex align-items-center gap-3 flex-grow-1 flex-wrap">

        <!-- 🔍 Search -->
        <div class="search-wrapper">
            <form asp-action="Index" method="get" id="filterForm">
                <i class="bi bi-search"></i>
                <input type="text" class="search-input" placeholder="@Localizer["SearchPlaceholder"]" value="@ViewData["SearchString"]" name="searchString" />
                <button type="submit" class="search-btn">@Localizer["SearchButton"]</button>
            </form>
        </div>

        <!-- 📂 Category Classification -->
        <div class="filter-group">
            <span class="filter-label"><i class="bi bi-layers me-1"></i> @Localizer["CategoryLabel"]</span>
            <div class="category-chips">
                <div class="chip @(ViewData["SelectedCategory"] == null ? "active" : "")">
                    <a href="/Customer/Home/Index"><i class="bi bi-grid-fill"></i> @Localizer["AllCategories"]</a>
                </div>
                @if (Model.Categories != null)
                {
                    @foreach (var category in Model.Categories)
                    {
                        <div class="chip @(ViewData["SelectedCategory"]?.ToString() == category.Id.ToString() ? "active" : "")">
                            <a href="/Customer/Home/Index?categoryId=@category.Id" class="d-flex align-items-center gap-2 text-decoration-none">
                                @if (!string.IsNullOrEmpty(category.Icon))
                                {
                                    if (category.Icon.Contains(" ") || category.Icon.StartsWith("fa-") || category.Icon.StartsWith("bi-"))
                                    {
                                        <i class="@category.Icon"></i>
                                    }
                                    else
                                    {
                                        <img src="/img/service_categories/@category.Icon" style="width: 18px; height: 18px; object-fit: contain;" />
                                    }
                                }
                                else
                                {
                                    <i class="bi bi-tag text-secondary"></i>
                                }
                                <span>@(isRtl ? category.NameAr : category.Name)</span>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- 📍 Location Filter -->
    <div class="d-flex align-items-center gap-2 ms-3 border-start ps-3">
        <div class="location-filter-group">
            <span class="filter-label"><i class="bi bi-geo-alt me-1"></i> @Localizer["LocationLabel"]</span>
            <div class="d-flex align-items-center gap-2">
                <select class="filter-select" id="governorateSelect">
                    <option value="" selected disabled>@Localizer["SelectGovernorate"]</option>
                </select>
                <select class="filter-select" id="districtSelect" disabled>
                    <option value="" selected disabled>@Localizer["SelectDistrict"]</option>
                </select>
                <button class="btn btn-dark fw-bold rounded-3 px-3 py-2" id="locationFilterBtn" type="button">
                    <i class="bi bi-sliders me-1"></i> @Localizer["FilterButton"]
                </button>
                @if (ViewData["SelectedCity"] != null || ViewData["SelectedDistrict"] != null)
                {
                    <a href="/Customer/Home/Index" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-bold" title="@Localizer["ClearLocationFilter"]">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</nav>
@if (Model.Banners != null && Model.Banners.Any())
{
    <section class="smart-banner">

        <div class="smart-banner-slider">

            @{
                int index = 0;
            }

            @foreach (var banner in Model.Banners
           .Where(b => b.IsActive
           && b.StartDate <= DateTime.Now
           && b.EndDate >= DateTime.Now))
            {
                <div class="smart-banner-item @(index == 0 ? "active" : "")">

                    <div class="smart-banner-content">

                        <div class="smart-banner-text">

                            <span class="smart-badge">
                                @Localizer["FeaturedBanner"]
                            </span>

                            <h2>@banner.Title</h2>

                            <p>
                                @Localizer["BannerSubtitle"]
                            </p>

                            @if (!string.IsNullOrEmpty(banner.LinkUrl))
                            {
                                <a href="@banner.LinkUrl"
                                   class="smart-banner-btn">

                                    @Localizer["DiscoverNow"]

                                    <i class="bi @(isRtl ? "bi-arrow-left" : "bi-arrow-right")"></i>

                                </a>
                            }

                        </div>

                        <div class="smart-banner-image">

                            <img src="~/img/banners/@banner.ImageUrl"
                                 alt="@banner.Title">

                        </div>

                    </div>

                </div>

                index++;
            }

        </div>

        <!-- Arrows -->

        <button class="smart-arrow prev" id="bannerPrev">
            <i class="bi bi-chevron-left"></i>
        </button>

        <button class="smart-arrow next" id="bannerNext">
            <i class="bi bi-chevron-right"></i>
        </button>

        <!-- Dots -->

        <div class="smart-dots">

            @{
                int dotIndex = 0;
            }

            @foreach (var banner in Model.Banners
           .Where(b => b.IsActive
           && b.StartDate <= DateTime.Now
           && b.EndDate >= DateTime.Now))
            {
                <span class="smart-dot @(dotIndex == 0 ? "active" : "")"></span>

                dotIndex++;
            }

        </div>

    </section>
}
<!-- 3. Main Content -->
<div class="main-layout">

    <!-- Sidebar: Workers List -->
    <aside class="workers-sidebar">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h5 class="mb-0">@Localizer["AvailableWorkersTitle"]</h5>
            <span class="text-muted fw-bold small">@(Model.Workers?.Count() ?? 0) @Localizer["ResultLabel"]</span>
        </div>

        @if (Model.Workers == null || !Model.Workers.Any())
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle-fill fs-1 mb-2"></i>
                <h5 class="fw-bold mb-0">@Localizer["NoWorkersAvailable"]</h5>
                <p class="text-muted fw-semibold mb-0">@Localizer["NoWorkersSubtitle"]</p>
            </div>
        }
        else
        {
            @foreach (var worker in Model.Workers)
            {
                var profilePictureUrl = "";
                if (!string.IsNullOrEmpty(worker.ProfilePicturePath))
                {
                    var cleanedPath = worker.ProfilePicturePath.Trim().Replace("\\", "/");
                    if (cleanedPath.StartsWith("~/"))
                    {
                        profilePictureUrl = Url.Content(cleanedPath);
                    }
                    else if (cleanedPath.StartsWith("/"))
                    {
                        profilePictureUrl = Url.Content("~" + cleanedPath);
                    }
                    else
                    {
                        profilePictureUrl = Url.Content("~/" + cleanedPath);
                    }
                }
                else
                {
                    profilePictureUrl = "https://images.unsplash.com/photo-1506803682981-6e718a9dd3ee?q=80&w=200&auto=format&fit=crop";
                }
                <div class="worker-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex gap-3">
                            <div class="avatar-container">
                                <img src="@profilePictureUrl" class="worker-avatar" alt="Worker">
                                <span class="online-dot" style="background-color: #f59e0b;"></span>
                            </div>
                            <div>
                                <h6 class="fw-800 mb-1 fs-5 d-flex align-items-center">
                                    @(worker.User?.FName) @(worker.User?.LName)
                                    <i class="bi bi-patch-check-fill verified-icon ms-1"></i>
                                </h6>
                                <p class="text-muted fw-semibold small mb-2">@(isRtl ? (worker.WorkerServices?.Category?.NameAr ?? Localizer["NotSpecified"].Value) : (worker.WorkerServices?.Category?.Name ?? Localizer["NotSpecified"].Value))</p>
                                <div class="d-flex gap-2">
                                    <span class="tag"><i class="bi bi-house-gear me-1"></i> @(worker.User?.Addresses?.FirstOrDefault()?.District ?? Localizer["DistrictNotSpecified"].Value)</span>
                                    <span class="tag"><i class="bi bi-geo-alt-fill me-1"></i> @(worker.User?.Addresses?.FirstOrDefault()?.City ?? Localizer["CityNotSpecified"].Value)</span>
                                </div>
                            </div>
                        </div>
                        <form method="post" action="/Customer/Home/ToggleFavorite">
                            <input type="hidden" name="workerId" value="@worker.Id" />
                            <button class="fav-btn @(Model.FavoriteWorkerIds.Contains(worker.Id) ? "active" : "")" type="submit">
                                @if (Model.FavoriteWorkerIds.Contains(worker.Id))
                                {
                                    <i class="bi bi-heart-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-heart"></i>
                                }
                            </button>
                        </form>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div class="price-tag">
                            @(worker.WorkerServices != null ? worker.WorkerServices.HourlyRate.ToString("N0") : "0")
                            <span class="fs-6 text-muted fw-semibold">@Localizer["InspectionFee"]</span>
                        </div>
                        <div class="d-flex gap-2">
                            @{
                                var addr = worker.User?.Addresses?.FirstOrDefault();
                                var lat = addr?.Lat ?? 30.0444;
                                var lng = addr?.Lng ?? 31.2357;
                            }
                            <button class="btn btn-outline-primary rounded-3 px-3 py-1 fw-bold small" onclick="showWorkerOnMap(@lat, @lng, '@(worker.User?.FName) @(worker.User?.LName)')">
                                <i class="bi bi-geo-alt-fill"></i> @Localizer["LocateOnMap"]
                            </button>
                            <a href="/Customer/Home/WorkerDetails/@worker.Id" class="btn-book">@Localizer["DetailsButton"]</a>
                        </div>
                    </div>

                    <div class="stats-row">
                        <div class="stat-item"><div class="rating-box"><i class="bi bi-star-fill"></i> @worker.RatingCount</div></div>
                        <div class="stat-item"><i class="bi bi-check-circle-fill text-success fs-6"></i> 55 @Localizer["CompletedTasks"]</div>
                    </div>
                </div>
            }
        }
    </aside>

    <!-- Main Map Area -->
    <main id="map-container">
        <div class="map-overlay">
            <div class="map-badge">
                <i class="bi bi-geo-alt-fill fs-1 text-primary mb-2 d-block"></i>
                <h4 class="fw-800 mb-1">@Localizer["InteractiveMapTitle"]</h4>
                <p class="text-muted fw-semibold mb-0">@Localizer["InteractiveMapLoading"]</p>
            </div>

            <!-- Emergency Button -->
            <button class="fab-emergency">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @Localizer["EmergencyRequest"]
            </button>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        var map;
        var marker;

        function initMap() {
            map = L.map('map-container').setView([26.8206, 30.8025], 6);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            document.querySelector('.map-overlay').style.display = 'none';
        }

        var mapPopupText = '@Localizer["MapPopupText"]';
        function showWorkerOnMap(lat, lng, name) {
            if (!map) initMap();

            if (marker) {
                map.removeLayer(marker);
            }

            map.setView([lat, lng], 15);

            marker = L.marker([lat, lng]).addTo(map)
                .bindPopup("<b>" + name + "</b><br>" + mapPopupText)
                .openPopup();
        }

        window.onload = function() {
            initMap();
