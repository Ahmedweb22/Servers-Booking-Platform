@model Shatbly.ViewModels.CustomerProfileVM
@{
    var isRtl = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture?.UICulture?.Name.StartsWith("ar") ?? false;
}

<style>
    .profile-container {
        max-width: 900px;
        margin: 0 auto;
    }
    .profile-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .profile-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
    }
    .profile-header-gradient {
        background: linear-gradient(135deg, #0f172a, #2563eb);
        padding: 40px 20px;
        color: white;
        text-align: center;
        position: relative;
    }
    .avatar-wrapper {
        width: 100px;
        height: 100px;
        background: white;
        color: #2563eb;
        font-size: 2.2rem;
        font-weight: 800;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto -50px auto;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        border: 4px solid white;
        text-transform: uppercase;
        position: relative;
        z-index: 2;
    }
    .profile-body {
        padding: 70px 40px 40px 40px;
    }
    .form-control-custom {
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        padding: 12px 16px;
        font-weight: 500;
        transition: all 0.3s ease;
        background-color: #f8fafc;
    }
    .form-control-custom:focus {
        background-color: #ffffff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
        outline: none;
    }
    .form-label-custom {
        font-weight: 700;
        font-size: 0.9rem;
        color: #475569;
        margin-bottom: 8px;
    }
    .btn-save-profile {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        border: none;
        color: white;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        letter-spacing: 0.3px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(37, 99, 230, 0.2);
    }
    .btn-save-profile:hover {
        background: linear-gradient(135deg, #1d4ed8, #1e40af);
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(37, 99, 230, 0.3);
    }
    .btn-save-profile:active {
        transform: translateY(0);
    }
    .info-badge {
        background: #f1f5f9;
        color: #475569;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
</style>

<div class="flex-grow-1 overflow-auto" style="height: calc(100vh - 76px); padding-bottom: 60px;">
    <div class="container py-5">
        <div class="profile-container">
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-center gap-2 alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="profile-card">
                <!-- Header Gradient -->
                <div class="profile-header-gradient">
                    <h2 class="fw-800 mb-2">@Localizer["ProfileSettings"]</h2>
                    <p class="text-white text-opacity-75 mb-0">@Localizer["PersonalInformation"]</p>
                </div>

                <!-- Avatar Circle representing User initials -->
                @{
                    var initials = "G";
                    if (!string.IsNullOrEmpty(Model.FName) && Model.FName.Length > 0)
                    {
                        initials = Model.FName.Substring(0, 1);
                        if (!string.IsNullOrEmpty(Model.LName) && Model.LName.Length > 0)
                        {
                            initials += Model.LName.Substring(0, 1);
                        }
                    }
                }
                <div class="avatar-wrapper">
                    @initials
                </div>

                <!-- Profile Body Form -->
                <div class="profile-body">
                    <form asp-action="Index" method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                        <div class="row g-4">
                            <!-- First Name -->
                            <div class="col-md-6">
                                <label asp-for="FName" class="form-label-custom">@Localizer["FirstName"]</label>
                                <input asp-for="FName" class="form-control form-control-custom" required placeholder="@Localizer["FirstName"]" />
                                <span asp-validation-for="FName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">
                                <label asp-for="LName" class="form-label-custom">@Localizer["LastName"]</label>
                                <input asp-for="LName" class="form-control form-control-custom" required placeholder="@Localizer["LastName"]" />
                                <span asp-validation-for="LName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Email Address (Read-Only) -->
                            <div class="col-md-12">
                                <label asp-for="Email" class="form-label-custom">@Localizer["Email"]</label>
                                <input asp-for="Email" class="form-control form-control-custom text-muted bg-light" readonly />
                                <div class="mt-2 text-muted small">
                                    <i class="bi bi-info-circle me-1"></i> @Localizer["EmailCannotBeChanged"]
                                </div>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label-custom">@Localizer["Phone"]</label>
                                <input asp-for="Phone" type="tel" class="form-control form-control-custom" required placeholder="01xxxxxxxxx" pattern="^(01)[0-9]{9}$" />
                                <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label-custom">@Localizer["Address"]</label>
                                <input asp-for="Address" class="form-control form-control-custom" placeholder="@Localizer["Address"]" />
                                <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end mt-5">
                            <button type="submit" class="btn btn-save-profile d-inline-flex align-items-center gap-2">
                                <i class="bi bi-floppy-fill"></i>
                                @Localizer["SaveChanges"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        // Bootstrap form validation logic
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
