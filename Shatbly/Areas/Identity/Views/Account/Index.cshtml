<section class="container cards-section">
        <div class="row g-4 justify-content-center">

            <div class="col-lg-5 col-md-6">
                <div class="card login-choice-card client-card p-5 text-center">
                    <div class="icon-circle">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-3 text-dark">@Localizer["IAmCustomer"]</h2>
                    <p class="text-muted mb-4 fs-5">@Localizer["CustomerDescription"]</p>
                    <div class="d-grid gap-3 mt-auto">
                        <a href="/Identity/Account/Login" class="btn btn-primary btn-custom">@Localizer["LoginAsCustomer"]</a>
                        <a href="/Identity/Account/Register" class="btn btn-outline-primary btn-custom">@Localizer["CreateNewAccount"]</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 col-md-6">
                <div class="card login-choice-card worker-card p-5 text-center">
                    <div class="icon-circle">
                        <i class="bi bi-tools"></i>
                    </div>
                    <h2 class="fw-bold mb-3">@Localizer["IAmWorker"]</h2>
                    <p class="text-light opacity-75 mb-4 fs-5">@Localizer["WorkerDescription"]</p>
                    <div class="d-grid gap-3 mt-auto">
                        <a href="/Identity/Account/WorkerLogin" class="btn btn-warning btn-custom text-dark">@Localizer["LoginAsWorker"]</a>
                    <a href="/Worker/Worker/SendCV" class="btn btn-outline-warning btn-custom">@Localizer["ApplyToJoin"]</a>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section class="container py-5 mt-5 mb-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-dark">@Localizer["WhyChooseShtbly"]</h2>
            <p class="text-muted fs-5">@Localizer["WhyChooseSubtitle"]</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon-wrapper">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="fw-bold mb-3">@Localizer["CompleteSafety"]</h4>
                    <p class="text-muted mb-0">@Localizer["SafetyDescription"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon-wrapper" style="background: linear-gradient(135deg, #F2C94C, #F2994A);">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <h4 class="fw-bold mb-3">@Localizer["WideCoverage"]</h4>
                    <p class="text-muted mb-0">@Localizer["CoverageDescription"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon-wrapper" style="background: linear-gradient(135deg, #11998e, #38ef7d);">
                        <i class="bi bi-star"></i>
                    </div>
                    <h4 class="fw-bold mb-3">@Localizer["RealReviews"]</h4>
                    <p class="text-muted mb-0">@Localizer["ReviewsDescription"]</p>
                </div>
            </div>
        </div>
    </section>

