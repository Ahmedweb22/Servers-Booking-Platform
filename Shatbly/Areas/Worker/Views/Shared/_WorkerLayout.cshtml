@using Microsoft.AspNetCore.Localization
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var reqCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var curCulture = reqCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isRtl = curCulture.StartsWith("ar");

    string IsActive(string controller, string? action = null)
    {
        var controllerMatches = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        var actionMatches = action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

        return controllerMatches && actionMatches ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="@curCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Shatbly Worker</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    @if (isRtl)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    }

    <style>
        :root {
            --worker-bg: #f5f7fb;
            --worker-sidebar: #101828;
            --worker-sidebar-muted: #98a2b3;
            --worker-primary: #2563eb;
            --worker-border: #e5e7eb;
        }

        body {
            background: var(--worker-bg);
            min-height: 100vh;
        }

        .worker-shell {
            min-height: 100vh;
            display: flex;
        }

        .worker-sidebar {
            width: 270px;
            background: var(--worker-sidebar);
            color: #fff;
            position: fixed;
            inset: 0 auto 0 0;
            padding: 24px 18px;
        }

        .worker-brand {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: .2px;
            margin-bottom: 28px;
        }

            .worker-brand span {
                color: var(--worker-primary);
            }

        .worker-nav {
            display: grid;
            gap: 8px;
        }

            .worker-nav a {
                color: var(--worker-sidebar-muted);
                text-decoration: none;
                padding: 12px 14px;
                border-radius: 8px;
                font-weight: 500;
                display: block;
            }

                .worker-nav a:hover,
                .worker-nav a.active {
                    background: rgba(255,255,255,.08);
                    color: #fff;
                }

        .worker-main {
            margin-left: 270px;
            width: calc(100% - 270px);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .worker-topbar {
            height: 72px;
            background: #fff;
            border-bottom: 1px solid var(--worker-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .worker-content {
            padding: 32px;
            max-width: 1180px;
            width: 100%;
            margin: 0 auto;
        }

        .page-card {
            background: #fff;
            border: 1px solid var(--worker-border);
            border-radius: 8px;
            box-shadow: 0 8px 24px rgba(16, 24, 40, .04);
        }

        .worker-footer {
            margin-top: auto;
            padding: 18px 32px;
            color: #667085;
            border-top: 1px solid var(--worker-border);
            background: #fff;
        }

        @@media (max-width: 991px) {
            .worker-shell {
                display: block;
            }

            .worker-sidebar {
                position: static;
                width: 100%;
                padding: 18px;
            }

            .worker-nav {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .worker-main {
                margin-left: 0;
                width: 100%;
            }

            .worker-topbar {
                padding: 0 18px;
            }

            .worker-content {
                padding: 18px;
            }
        }
    </style>
</head>
<body>
    <div class="worker-shell">
        <aside class="worker-sidebar">
            <div class="worker-brand">Shatbly<span>.</span></div>

            <nav class="worker-nav">
                <a asp-area="Worker"
                   asp-controller="WorkerProfile"
                   asp-action="Details"
                   class="@IsActive("WorkerProfile")">
                    @Localizer["Profile"]
                </a>

                <a asp-area="Worker"
                   asp-controller="Availability"
                   asp-action="Index"
                   class="@IsActive("Availability")">
                    @Localizer["Availability"]
                </a>

                <a asp-area="Worker"
                   asp-controller="Booking"
                   asp-action="Index"
                   class="@IsActive("Booking")">
                    @Localizer["Bookings"]
                </a>
                <a asp-area="Worker"
                   asp-controller="Messages"
                   asp-action="Index"
                   class="nav-link-custom @IsActive("Messages")">
                    <i class="bi bi-chat-dots me-1"></i>
                    @Localizer["Messages"]
                    <span id="unreadNotificationsCountContainer">
                        @await Component.InvokeAsync("UnreadNotifications")
                    </span>
                </a>

                <a asp-area="Worker"
                   asp-controller="Portfolio"
                   asp-action="Index"
                   class="@IsActive("Portfolio")">
                    @Localizer["Portfolio"]
                </a>

                <a asp-area="Worker"
                   asp-controller="Review"
                   asp-action="Index"
                   class="@IsActive("Review")">
                    @Localizer["Reviews"]
                </a>

                <a asp-area="Worker"
                   asp-controller="Withdrawal"
                   asp-action="Index"
                   class="@IsActive("Withdrawal")">
                    @Localizer["Withdrawals"]
                </a>
            </nav>
        </aside>

        <main class="worker-main">
            <header class="worker-topbar">
                <div>
                    <div class="fw-semibold">@Localizer["WorkerDashboard"]</div>
                    <div class="text-muted small">@DateTime.Now.ToString("dddd, dd MMM yyyy")</div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    @await Html.PartialAsync("_LanguageSwitcher")

                    <span class="text-muted small">@User.Identity?.Name</span>

                    <a asp-area="Identity"
                       asp-controller="Account"
                       asp-action="Logout"
                       class="btn btn-sm btn-outline-secondary">
                        @Localizer["Logout"]
                    </a>
                </div>
            </header>

            <section class="worker-content">
                @if (TempData["Success"] is not null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] is not null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @RenderBody()
            </section>

            <footer class="worker-footer">
                &copy; @DateTime.Now.Year - @Localizer["FooterText"]
            </footer>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const notificationConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/notifications")
                    .withAutomaticReconnect()
                    .build();

                notificationConnection.on("ReceiveNotification", function (notification) {
                    console.log("New notification received:", notification);

                    // 1. Update the header badge count
                    const container = document.getElementById("unreadNotificationsCountContainer");
                    if (container) {
                        let badge = container.querySelector(".badge");
                        if (badge) {
                            let count = parseInt(badge.textContent.trim()) || 0;
                            badge.textContent = count + 1;
                        } else {
                            container.innerHTML = `<span class="badge bg-danger rounded-pill ms-1">1</span>`;
                        }
                    }

                    // 2. Show Toastr notification if toastr is loaded
                    if (typeof toastr !== "undefined") {
                        toastr.info(notification.message, notification.title, {
                            timeOut: 8000,
                            closeButton: true,
                            progressBar: true
                        });
                    }

                    // 3. Update messages page list in real-time if we are on the notifications/messages page
                    const notificationsList = document.getElementById("notificationsList");
                    if (notificationsList) {
                        const emptyAlert = document.getElementById("emptyNotificationsAlert");
                        if (emptyAlert) emptyAlert.remove();

                        const isRtl = document.documentElement.getAttribute("dir") === "rtl";
                        const item = document.createElement("div");
                        item.className = "list-group-item d-flex justify-content-between align-items-start";

                        let actionButtons = "";
                        // Map NotificationType
                        const typeVal = typeof notification.type === "string" ? notification.type : 
                                      (notification.type === 0 ? "Message" : 
                                       notification.type === 1 ? "BookingUpdate" : 
                                       notification.type === 2 ? "PaymentUpdate" : 
                                       notification.type === 3 ? "Promotion" : "System");

                        if (typeVal === "Message" && notification.bookingId) {
                            actionButtons += `
                                <a href="/Worker/Chat/Conversation?bookingId=${notification.bookingId}" class="btn btn-sm btn-success">
                                    Open Chat
                                </a>
                            `;
                        }

                        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                        const tokenValue = tokenElement ? tokenElement.value : "";

                        actionButtons += `
                            <form action="/Worker/Messages/MarkAsRead" method="post" style="margin:0;">
                                <input type="hidden" name="__RequestVerificationToken" value="${tokenValue}" />
                                <input type="hidden" name="id" value="${notification.id}" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    Mark Read
                                </button>
                            </form>
                            <form action="/Worker/Messages/Delete" method="post" style="margin:0;">
                                <input type="hidden" name="__RequestVerificationToken" value="${tokenValue}" />
                                <input type="hidden" name="id" value="${notification.id}" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        `;

                        const dateStr = new Date(notification.createdAt).toLocaleString([], { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

                        item.innerHTML = `
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <strong>${notification.title}</strong>
                                    <span class="badge bg-primary">New</span>
                                </div>
                                <p class="mb-1">${notification.message}</p>
                                <small class="text-muted">
                                    ${typeVal} - ${dateStr}
                                </small>
                            </div>
                            <div class="d-flex gap-2">
                                ${actionButtons}
                            </div>
                        `;

                        notificationsList.insertBefore(item, notificationsList.firstChild);
                    }
                });

                notificationConnection.start()
                    .then(() => console.log("Connected to NotificationHub successfully!"))
                    .catch(err => console.error("Error connecting to NotificationHub:", err));
            });
        </script>
    }
</body>
</html>