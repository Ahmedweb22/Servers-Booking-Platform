@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject IViewLocalizer Localizer
@model WorkerVM
@{
    var isRtl = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture?.UICulture?.Name.StartsWith("ar") ?? false;
}

    <title>@Localizer["PageTitle"]</title>
    @if (isRtl)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    }
    else
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; background-color: #f8f9fa; }
        .hero-section {
            background: linear-gradient(rgba(10, 38, 71, 0.85), rgba(10, 38, 71, 0.85)),
                        url('https://images.unsplash.com/photo-1581094794329-c8112a89af12?q=80&w=2070');
            background-size: cover;
            padding: 80px 0 140px;
            color: white;
            text-align: center;
        }
        .auth-card { border: none; border-radius: 25px; overflow: hidden; }
        .password-strength-bar { height: 5px; border-radius: 5px; transition: all 0.3s; }
    </style>


<section class="container" style="margin-top: 40px; margin-bottom: 60px;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card auth-card shadow-lg p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width:70px;height:70px;font-size:2rem;">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-1">@Localizer["SubmitCVCardTitle"]</h2>
                    <p class="text-muted small">@Localizer["SubmitCVCardSubtitle"]</p>
                </div>

                <form asp-action="SendCV" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Name Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FName" class="form-label fw-bold">@Localizer["FirstNameLabel"]</label>
                            <div class="input-group">
                                <input asp-for="FName" class="form-control" placeholder="@Localizer["FirstNamePlaceholder"]" required minlength="2" autocomplete="given-name">
                                <span asp-validation-for="FName" class="text-danger w-100 mt-1 small"></span>
                                <div class="invalid-feedback">@Localizer["FirstNameInvalid"]</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LName" class="form-label fw-bold">@Localizer["LastNameLabel"]</label>
                            <div class="input-group">
                                <input asp-for="LName" class="form-control" placeholder="@Localizer["LastNamePlaceholder"]" required minlength="2" autocomplete="family-name">
                                <span asp-validation-for="LName" class="text-danger w-100 mt-1 small"></span>
                                <div class="invalid-feedback">@Localizer["LastNameInvalid"]</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">@Localizer["EmailLabel"]</label>
                        <div class="input-group">
                            <input asp-for="Email" type="email" class="form-control" placeholder="@Localizer["EmailPlaceholder"]" required autocomplete="email">
                            <span asp-validation-for="Email" class="text-danger w-100 mt-1 small"></span>
                            <div class="invalid-feedback">@Localizer["EmailInvalid"]</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-bold">@Localizer["PhoneLabel"]</label>
                        <div class="input-group">
                            <input asp-for="Phone" type="tel" class="form-control" placeholder="@Localizer["PhonePlaceholder"]" required pattern="^(01)[0-9]{9}$" autocomplete="tel">
                            <span asp-validation-for="Phone" class="text-danger w-100 mt-1 small"></span>
                            <div class="invalid-feedback">@Localizer["PhoneInvalid"]</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="cv" class="form-label fw-bold">@Localizer["CvLabel"]</label>
                        <div class="input-group">
                            <input asp-for="cv" type="file" class="form-control" required>
                            <span asp-validation-for="cv" class="text-danger w-100 mt-1 small"></span>
                            <div class="invalid-feedback">@Localizer["CvInvalid"]</div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary w-100 fw-bold py-3 shadow">@Localizer["SubmitBtn"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

@section Scripts {
    <partial name="~/Views/Shared/_NotificationPartial.cshtml" />
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}