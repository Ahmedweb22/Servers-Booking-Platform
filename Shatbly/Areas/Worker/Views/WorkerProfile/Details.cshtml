@model Shatbly.ViewModels.WorkerProfileVM
@using Microsoft.AspNetCore.Localization
@{
    var reqCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var curCulture = reqCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isRtl = curCulture.StartsWith("ar");
    ViewData["Title"] = isRtl ? "الملف الشخصي للفني - شطبلي" : "Worker Profile - Shatbly";
    
    var initials = "";
    if (!string.IsNullOrEmpty(Model.WorkerName))
    {
        var parts = Model.WorkerName.Split('@')[0].Split('.');
        if (parts.Length > 1)
        {
            initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }
        else
        {
            initials = Model.WorkerName.Substring(0, Math.Min(2, Model.WorkerName.Length)).ToUpper();
        }
    }

    var profilePictureUrl = "";
    if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
    {
        var cleanedPath = Model.ProfilePicturePath.Trim().Replace("\\", "/");
        if (cleanedPath.StartsWith("~/"))
        {
            profilePictureUrl = Url.Content(cleanedPath);
        }
        else if (cleanedPath.StartsWith("/"))
        {
            profilePictureUrl = Url.Content("~" + cleanedPath);
        }
        else
        {
            profilePictureUrl = Url.Content("~/" + cleanedPath);
        }
    }
}

<style>
    .profile-card {
        border-radius: 20px;
        border: none;
        box-shadow: 0 10px 30px rgba(16, 24, 40, 0.04);
        background: #ffffff;
    }
    .profile-banner {
        height: 140px;
        background: linear-gradient(135deg, #101828 0%, #2563eb 100%);
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        position: relative;
    }
    .avatar-wrapper {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        border: 5px solid #ffffff;
        background: #f3f4f6;
        position: absolute;
        bottom: -65px;
        left: 30px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    html[dir="rtl"] .avatar-wrapper {
        left: auto;
        right: 30px;
    }
    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .avatar-initials {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: 800;
        background: #eff6ff;
        color: #2563eb;
    }
    .avatar-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .avatar-wrapper:hover .avatar-overlay {
        opacity: 1;
    }
    .avatar-overlay i {
        font-size: 1.5rem;
        margin-bottom: 4px;
    }
    .avatar-overlay span {
        font-size: 0.75rem;
        font-weight: 600;
    }
    .profile-info-section {
        padding-top: 80px;
    }
    .detail-item-card {
        border: 1px solid #f3f4f6;
        border-radius: 16px;
        padding: 20px;
        transition: all 0.3s ease;
        height: 100%;
        background: #fafafa;
    }
    .detail-item-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.02);
        border-color: rgba(37, 99, 235, 0.15);
    }
    .card-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(37, 99, 235, 0.06);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 15px;
    }
    .bio-container {
        border-left: 4px solid #2563eb;
        padding-left: 20px;
    }
    html[dir="rtl"] .bio-container {
        border-left: none;
        border-right: 4px solid #2563eb;
        padding-left: 0;
        padding-right: 20px;
    }
</style>

<div class="container py-4">
    <!-- Action/Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">@(isRtl ? "الملف الشخصي" : "Worker Profile")</h2>
            <p class="text-muted mb-0">@(isRtl ? "إدارة وتعديل بيانات ملفك الشخصي وصورتك الشخصية" : "Manage and update your profile details and avatar")</p>
        </div>

        <a asp-action="Edit" class="btn btn-outline-primary px-4 py-2 fw-semibold" style="border-radius: 10px;">
            <i class="bi bi-pencil-square me-2"></i>@(isRtl ? "تعديل الملف" : "Edit Profile")
        </a>
    </div>

    <!-- Hidden Form for Image Upload -->
    <form id="avatarUploadForm" asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" style="position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; overflow: hidden;">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input type="file" id="avatarFileInput" name="ProfilePictureFile" accept=".jpg,.jpeg,.png" />
    </form>

    <div class="card profile-card mb-4 overflow-hidden">
        <!-- Banner and Avatar -->
        <div class="profile-banner">
            <div class="avatar-wrapper" onclick="document.getElementById('avatarFileInput').click()">
                @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                {
                    <img src="@profilePictureUrl" class="avatar-img" alt="Profile Picture" />
                }
                else
                {
                    <div class="avatar-initials">@initials</div>
                }
                <div class="avatar-overlay">
                    <i class="bi bi-camera-fill"></i>
                    <span>@(isRtl ? "تغيير الصورة" : "Change Photo")</span>
                </div>
            </div>
        </div>

        <!-- Basic Info Section -->
        <div class="card-body profile-info-section px-4 pb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
                <div class="@(isRtl ? "text-end" : "text-start")">
                    <h3 class="fw-bold mb-1 d-flex align-items-center gap-2 text-dark">
                        @Model.WorkerName
                        @if (Model.IsVerified)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-1" style="border-radius: 20px;">
                                <i class="bi bi-patch-check-fill me-1"></i>@(isRtl ? "موثق" : "Verified")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6 px-3 py-1" style="border-radius: 20px;">
                                <i class="bi bi-hourglass-split me-1"></i>@(isRtl ? "قيد التحقق" : "Pending Verification")
                            </span>
                        }
                    </h3>
                    <p class="text-muted mb-0">@(isRtl ? "فني مسجل في منصة شطبلي" : "Registered Professional at Shatbly")</p>
                </div>
            </div>

            <!-- Bio -->
            <div class="bio-container mb-4 mt-3 @(isRtl ? "text-end" : "text-start")">
                <h5 class="fw-bold text-dark mb-2">@(isRtl ? "النبذة التعريفية" : "Bio / Description")</h5>
                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <p class="text-secondary mb-0" style="white-space: pre-line;">@Model.Bio</p>
                }
                else
                {
                    <p class="text-muted mb-0 italic">@(isRtl ? "لم تقم بكتابة نبذة تعريفية بعد." : "No bio details provided yet.")</p>
                }
            </div>

            <hr class="my-4 text-light" />

            <!-- Stats/Attributes Grid -->
            <div class="row g-4 @(isRtl ? "text-end" : "text-start")">
                <!-- Rating -->
                <div class="col-md-6 col-lg-4">
                    <div class="detail-item-card">
                        <div class="card-icon"><i class="bi bi-star-fill text-warning"></i></div>
                        <h6 class="fw-bold text-muted mb-1">@(isRtl ? "التقييم العام" : "Rating Average")</h6>
                        <h4 class="fw-bold text-dark mb-0">@Model.RatingAvg.ToString("0.00") / 5</h4>
                        <small class="text-muted">(@Model.RatingCount @(isRtl ? "تقييمات" : "reviews"))</small>
                    </div>
                </div>

                <!-- Specialty -->
                <div class="col-md-6 col-lg-4">
                    <div class="detail-item-card">
                        <div class="card-icon"><i class="bi bi-briefcase-fill text-primary"></i></div>
                        <h6 class="fw-bold text-muted mb-1">@(isRtl ? "القسم / التخصص" : "Specialty")</h6>
                        <h4 class="fw-bold text-dark mb-0">@(string.IsNullOrEmpty(Model.CategoryName) ? (isRtl ? "غير محدد" : "Not Specified") : Model.CategoryName)</h4>
                        <small class="text-muted">@(isRtl ? "تخصصك الحالي المسجل" : "Your current service category")</small>
                    </div>
                </div>

                <!-- Hourly Rate -->
                <div class="col-md-6 col-lg-4">
                    <div class="detail-item-card">
                        <div class="card-icon"><i class="bi bi-cash-coin text-success"></i></div>
                        <h6 class="fw-bold text-muted mb-1">@(isRtl ? "سعر الساعة" : "Hourly Rate")</h6>
                        <h4 class="fw-bold text-dark mb-0">@Model.HourlyRate.ToString("N0") @(isRtl ? "ج.م / ساعة" : "EGP / hr")</h4>
                        <small class="text-muted">@(isRtl ? "تسعير ساعة العمل الخاصة بك" : "Your hourly price rate")</small>
                    </div>
                </div>

                <!-- Availability -->
                <div class="col-md-6 col-lg-4">
                    <div class="detail-item-card d-flex flex-column justify-content-between">
                        <div>
                            <div class="card-icon">
                                <i class="bi @(Model.IsAvailable ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                            </div>
                            <h6 class="fw-bold text-muted mb-1">@(isRtl ? "حالة التوافر للعمل" : "Availability Status")</h6>
                            <h4 class="fw-bold mb-2">
                                @if (Model.IsAvailable)
                                {
                                    <span class="text-success">@(isRtl ? "متاح للعمل" : "Available")</span>
                                }
                                else
                                {
                                    <span class="text-secondary">@(isRtl ? "غير متاح حالياً" : "Unavailable")</span>
                                }
                            </h4>
                        </div>
                        <form asp-action="ToggleAvailability" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100 py-2 fw-semibold" style="border-radius: 8px;">
                                <i class="bi bi-arrow-repeat me-1"></i>@(isRtl ? "تغيير حالة التوفر" : "Toggle Availability")
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Accepts Online -->
                <div class="col-md-6 col-lg-4">
                    <div class="detail-item-card">
                        <div class="card-icon"><i class="bi bi-globe2"></i></div>
                        <h6 class="fw-bold text-muted mb-1">@(isRtl ? "الطلبات الإلكترونية" : "Accepts Online Bookings")</h6>
                        <h4 class="fw-bold text-dark mb-0">
                            @(Model.AcceptsOnline ? (isRtl ? "يقبل الطلبات" : "Yes, Accepts") : (isRtl ? "لا يقبل الطلبات" : "No"))
                        </h4>
                        <small class="text-muted">@(isRtl ? "إمكانية الحجز المباشر عبر الموقع" : "Direct scheduling via platform")</small>
                    </div>
                </div>

                <!-- Created At -->
                <div class="col-md-6 col-lg-4">
                    <div class="detail-item-card">
                        <div class="card-icon"><i class="bi bi-calendar-event"></i></div>
                        <h6 class="fw-bold text-muted mb-1">@(isRtl ? "تاريخ التسجيل" : "Registration Date")</h6>
                        <h4 class="fw-bold text-dark mb-0">@Model.CreatedAt.ToString("yyyy-MM-dd")</h4>
                        <small class="text-muted">@(isRtl ? "تاريخ الانضمام لشطبلي" : "Joined Shatbly platform")</small>
                    </div>
                </div>

                <!-- CV Section -->
                <div class="col-md-6 col-lg-4">
                    <div class="detail-item-card">
                        <div class="card-icon"><i class="bi bi-file-pdf"></i></div>
                        <h6 class="fw-bold text-muted mb-1">@(isRtl ? "الملف الشخصي / السيرة الذاتية" : "CV & Qualifications")</h6>
                        <div class="mt-2">
                            @if (!string.IsNullOrWhiteSpace(Model.CVPath))
                            {
                                var isPath = Model.CVPath.Contains('/') || Model.CVPath.Contains('\\');
                                var cvUrl = isPath ? Url.Content("~/" + Model.CVPath.Replace("\\", "/")) : Url.Content("~/img/worker/worker_cv/" + Model.CVPath);
                                <a href="@cvUrl" target="_blank" class="btn btn-sm btn-primary w-100 py-2 fw-semibold" style="border-radius: 8px;">
                                    <i class="bi bi-download me-1"></i>@(isRtl ? "تحميل السيرة الذاتية" : "Download CV")
                                </a>
                            }
                            else
                            {
                                <div class="text-muted py-1">
                                    <i class="bi bi-x-circle me-1"></i>@(isRtl ? "لم يتم رفع سيرة ذاتية بعد" : "No CV uploaded")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4 text-light" />

            <!-- Weekly Working Hours Section -->
            <div class="@(isRtl ? "text-end" : "text-start") mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="bi bi-clock-history me-2 text-primary"></i>@(isRtl ? "ساعات العمل الأسبوعية (التوافر)" : "Weekly Working Hours (Availability)")
                        </h5>
                        <p class="text-muted small mb-0">@(isRtl ? "ساعات عملك التي تظهر للعملاء لحجز المواعيد" : "Your configured work hours that clients see for bookings")</p>
                    </div>
                    <a href="/Worker/Availability/Create" class="btn btn-sm btn-primary px-3 py-2 fw-semibold" style="border-radius: 8px;">
                        <i class="bi bi-plus-circle me-1"></i>@(isRtl ? "إضافة فترة عمل" : "Add Time Slot")
                    </a>
                </div>

                @if (Model.Availabilities != null && Model.Availabilities.Any())
                {
                    var dayNames = new Dictionary<string, string> {
                        {"Sunday", isRtl ? "الأحد" : "Sunday"},
                        {"Monday", isRtl ? "الاثنين" : "Monday"},
                        {"Tuesday", isRtl ? "الثلاثاء" : "Tuesday"},
                        {"Wednesday", isRtl ? "الأربعاء" : "Wednesday"},
                        {"Thursday", isRtl ? "الخميس" : "Thursday"},
                        {"Friday", isRtl ? "الجمعة" : "Friday"},
                        {"Saturday", isRtl ? "السبت" : "Saturday"}
                    };

                    var groupedSchedule = Model.Availabilities.GroupBy(x => x.DayOfWeek.ToString()).ToDictionary(x => x.Key, x => x.ToList());

                    <div class="row g-3">
                        @foreach (var dayKey in new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
                        {
                            var dayLabel = dayNames[dayKey];
                            var slots = groupedSchedule.GetValueOrDefault(dayKey) ?? new List<Avalability>();

                            <div class="col-md-6 col-xl-4">
                                <div class="card h-100 border shadow-none" style="border-radius: 12px; background: #fafafa;">
                                    <div class="card-header bg-transparent border-bottom py-2 px-3 fw-bold text-dark d-flex justify-content-between align-items-center">
                                        <span>@dayLabel</span>
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill small">@slots.Count @(isRtl ? "فترات" : "slots")</span>
                                    </div>
                                    <div class="card-body p-3">
                                        @if (!slots.Any())
                                        {
                                            <p class="text-muted small mb-0 italic"><i class="bi bi-calendar-x me-1"></i>@(isRtl ? "غير متاح" : "Not Available")</p>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var slot in slots.OrderBy(s => s.StartTime))
                                                {
                                                    <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded-3 border">
                                                        <span class="small fw-semibold text-secondary">
                                                            @slot.StartTime.ToString(@"hh\:mm") @(isRtl ? "إلى" : "to") @slot.EndTime.ToString(@"hh\:mm")
                                                        </span>
                                                        <div class="d-flex gap-2">
                                                            <a href="/Worker/Availability/Edit/@slot.Id" class="btn btn-sm btn-link text-primary p-0" title="@(isRtl ? "تعديل" : "Edit")">
                                                                <i class="bi bi-pencil-fill text-primary" style="font-size: 1.1rem;"></i>
                                                            </a>
                                                            <form action="/Worker/Availability/Delete/@slot.Id" method="post" onsubmit="return confirm('@(isRtl ? "هل أنت متأكد من حذف هذه الفترة؟" : "Are you sure you want to delete this slot?")');" style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="@(isRtl ? "حذف" : "Delete")">
                                                                    <i class="bi bi-trash-fill text-danger" style="font-size: 1.1rem;"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center p-4 border rounded-3 bg-light">
                        <i class="bi bi-calendar-x text-muted fs-2"></i>
                        <p class="text-muted mt-2 mb-0">@(isRtl ? "لم تقم بتهيئة ساعات العمل بعد. يرجى إضافة فترات تواجدك ليتمكن العملاء من حجز خدماتك." : "No working hours configured yet. Please add slots so customers can book you.")</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Trigger auto-submit when user chooses an image
            $('#avatarFileInput').on('change', function () {
                if (this.files && this.files[0]) {
                    $('#avatarUploadForm').submit();
                }
            });
        });
    </script>
}
