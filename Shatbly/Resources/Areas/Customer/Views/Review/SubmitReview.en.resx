  <data name="RatingHint3" xml:space="preserve"><value>Acceptable 🙂</value></data>
  <data name="RatingHint4" xml:space="preserve"><value>Very Good 😊</value></data>
  <data name="RatingHint5" xml:space="preserve"><value>Excellent! 🤩</value></data>
