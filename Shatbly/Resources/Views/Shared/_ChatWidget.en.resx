    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" msdata:Ordinal="0" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <data name="ChatHeader" xml:space="preserve"><value>Booking Assistant</value></data>
  <data name="WelcomeMessage" xml:space="preserve"><value>Hello! How can I help you with booking?</value></data>
  <data name="InputPlaceholder" xml:space="preserve"><value>Type your question...</value></data>
  <data name="ErrorMessage" xml:space="preserve"><value>Sorry, an error occurred. Please try again.</value></data>
  <data name="Typing" xml:space="preserve"><value>Typing...</value></data>
</root>
