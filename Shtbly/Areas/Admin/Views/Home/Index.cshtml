@model DashboardStatsCardCountVM
@{
    ViewBag.Title = "Dashboard";

    var stats = new[]
    {
        new { Title = "Total Users", Value = Model.UsersCount.ToString("N0"), Icon = "fa-solid fa-users", IconBgClass = "bg-soft-primary", Trend = "Active", TrendClass = "text-success" },
        new { Title = "Total Services", Value = Model.ServicesCategoriesCount.ToString("N0"), Icon = "fa-solid fa-briefcase", IconBgClass = "bg-soft-warning", Trend = "Active", TrendClass = "text-success" },
        new { Title = "Total Orders", Value = Model.OrdersCount.ToString("N0"), Icon = "fa-solid fa-cart-shopping", IconBgClass = "bg-soft-success", Trend = "Total Bookings", TrendClass = "text-success" },
        new { Title = "Revenue", Value = "EGP " + Model.TotalRevenue.ToString("N2"), Icon = "fa-solid fa-dollar-sign", IconBgClass = "bg-soft-danger", Trend = "Completed & Confirmed", TrendClass = "text-success" }
    };
}

<div class="page-header mb-4">
    <div>
        <h2 class="page-title">Dashboard Overview</h2>
        <p class="page-subtitle mb-0">Welcome back, here is what’s happening across your platform today.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light btn-soft" onclick="window.print()">
            <i class="fa-solid fa-download me-2"></i>Export PDF
        </button>
        <a href="/Admin/Booking" class="btn btn-primary btn-soft">
            <i class="fa-solid fa-eye me-2"></i>Manage Bookings
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    @foreach (var item in stats)
    {
        <partial name="~/Areas/Admin/Views/Shared/_StatCard.cshtml" model="item" />
    }
</div>
<div class="row g-4 mb-4">
    <div class="col-12 col-xl-8">
        <div class="dashboard-card chart-card">
            <div class="section-head">
                <div>
                    <h5 class="mb-1">Orders Over Time</h5>
                    <p class="text-muted mb-0">Monthly trend for new orders</p>
                </div>
            </div>
            <div class="chart-wrap chart-lg">
                <canvas id="ordersLineChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="dashboard-card chart-card h-100">
            <div class="section-head">
                <div>
                    <h5 class="mb-1">User Distribution</h5>
                    <p class="text-muted mb-0">Registered users by role</p>
                </div>
            </div>
            <div class="chart-wrap chart-md">
                <canvas id="usersPieChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="dashboard-card chart-card">
            <div class="section-head">
                <div>
                    <h5 class="mb-1">Services Usage</h5>
                    <p class="text-muted mb-0">Most requested service categories</p>
                </div>
            </div>
            <div class="chart-wrap chart-md">
                <canvas id="servicesBarChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-card">
    <div class="section-head mb-3">
        <div>
            <h5 class="mb-1">Recent Orders</h5>
            <p class="text-muted mb-0">Latest transactions and service requests</p>
        </div>
        <a href="/Admin/Booking" class="btn btn-light btn-soft">View All</a>
    </div>

    <div class="table-responsive">
        <table class="table orders-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>User</th>
                    <th>Service</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                {
                    @foreach (var order in Model.RecentOrders)
                    {
                        var badgeClass = "bg-secondary-subtle text-secondary";
                        if (order.Status == OrderStatuses.Completed) { badgeClass = "bg-success-subtle text-success"; }
                        else if (order.Status == OrderStatuses.Pending) { badgeClass = "bg-warning-subtle text-warning"; }
                        else if (order.Status == OrderStatuses.Confirmed) { badgeClass = "bg-primary-subtle text-primary"; }
                        else if (order.Status == OrderStatuses.Rescheduled) { badgeClass = "bg-info-subtle text-info"; }
                        else if (order.Status == OrderStatuses.Cancelled || order.Status == OrderStatuses.Rejected) { badgeClass = "bg-danger-subtle text-danger"; }

                        <tr>
                            <td class="fw-semibold">#ORD-@order.Id</td>
                            <td>@(order.User?.Name ?? order.User?.Email ?? "Customer")</td>
                            <td>@(order.Service?.Name ?? "General Service")</td>
                            <td>
                                <span class="badge rounded-pill custom-badge @badgeClass">@order.Status</span>
                            </td>
                            <td class="text-muted">@order.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No recent orders found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const gridColor = 'rgba(148, 163, 184, 0.18)';
        const labelColor = '#64748b';

        new Chart(document.getElementById('ordersLineChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.MonthlyOrderLabels)),
                datasets: [{
                    label: 'Orders',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.MonthlyOrderCounts)),
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.12)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#2563eb',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: labelColor }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: gridColor },
                        ticks: { color: labelColor }
                    }
                }
            }
        });

        new Chart(document.getElementById('servicesBarChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.ServicesUsageLabels)),
                datasets: [{
                    label: 'Usage',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.ServicesUsageCounts)),
                    backgroundColor: ['#0f172a', '#2563eb', '#14b8a6', '#f59e0b', '#8b5cf6', '#ef4444'],
                    borderRadius: 10,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: labelColor }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: gridColor },
                        ticks: { color: labelColor }
                    }
                }
            }
        });

        new Chart(document.getElementById('usersPieChart'), {
            type: 'pie',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.UserDistributionLabels)),
                datasets: [{
                    data: @Html.Raw(JsonSerializer.Serialize(Model.UserDistributionCounts)),
                    backgroundColor: ['#cbd5e1', '#2563eb', '#0f172a', '#8b5cf6', '#ef4444'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: labelColor,
                            usePointStyle: true,
                            boxWidth: 10,
                            padding: 18
                        }
                    }
                }
            }
        });
    </script>
}
