@model Shtbly.ViewModels.AdminReportVM
@{
    ViewBag.Title = "Reports & Analytics";
}

<style>
    .report-card {
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        background: #ffffff;
        transition: all 0.3s ease;
    }
    .report-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
    }
    .stat-gradient-1 {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: white;
    }
    .stat-gradient-2 {
        background: linear-gradient(135deg, #065f46 0%, #10b981 100%);
        color: white;
    }
    .stat-gradient-3 {
        background: linear-gradient(135deg, #7c2d12 0%, #f97316 100%);
        color: white;
    }
    .progress-bar-custom {
        height: 8px;
        border-radius: 4px;
        background-color: #f1f5f9;
    }
    .progress-fill-primary {
        background-color: #2563eb;
        height: 100%;
        border-radius: 4px;
    }
    .progress-fill-success {
        background-color: #10b981;
        height: 100%;
        border-radius: 4px;
    }
    .progress-fill-danger {
        background-color: #ef4444;
        height: 100%;
        border-radius: 4px;
    }
</style>

<div class="page-header mb-4">
    <div>
        <h2 class="page-title">Reports & Analytics</h2>
        <p class="page-subtitle mb-0">Gain insight into your service bookings, revenue performance, and user activity.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/User/ExportPdf" class="btn btn-primary">
            <i class="fa-solid fa-file-pdf me-2"></i>Download Users PDF Report
        </a>
        <button class="btn btn-outline-secondary" onclick="window.print()">
            <i class="fa-solid fa-print me-2"></i>Print Page
        </button>
    </div>
</div>

<!-- Stat Row -->
<div class="row g-4 mb-4">
    <!-- Revenue -->
    <div class="col-12 col-md-4">
        <div class="card report-card stat-gradient-1 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-semibold uppercase tracking-wider" style="font-size: 0.85rem; opacity: 0.9;">Total Revenue</span>
                <i class="fa-solid fa-wallet fs-4" style="opacity: 0.8;"></i>
            </div>
            <h2 class="fw-bold mb-1">EGP @Model.TotalRevenue.ToString("N2")</h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.8;">Average Order Value: EGP @Model.AverageBookingValue.ToString("N2")</p>
        </div>
    </div>

    <!-- Bookings -->
    <div class="col-12 col-md-4">
        <div class="card report-card stat-gradient-2 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-semibold uppercase tracking-wider" style="font-size: 0.85rem; opacity: 0.9;">Total Bookings</span>
                <i class="fa-solid fa-calendar-check fs-4" style="opacity: 0.8;"></i>
            </div>
            <h2 class="fw-bold mb-1">@Model.TotalBookings.ToString("N0")</h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.8;">Completed: @Model.CompletedBookings | Pending: @Model.PendingBookings</p>
        </div>
    </div>

    <!-- Users -->
    <div class="col-12 col-md-4">
        <div class="card report-card stat-gradient-3 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-semibold uppercase tracking-wider" style="font-size: 0.85rem; opacity: 0.9;">Platform Users</span>
                <i class="fa-solid fa-users fs-4" style="opacity: 0.8;"></i>
            </div>
            <h2 class="fw-bold mb-1">@(Model.TotalCustomers + Model.TotalWorkers + Model.TotalAdmins)</h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.8;">Customers: @Model.TotalCustomers | Workers: @Model.TotalWorkers</p>
        </div>
    </div>
</div>

<!-- Detailed Stats Card -->
<div class="row g-4 mb-4">
    <!-- Booking Status Breakdown -->
    <div class="col-12 col-lg-5">
        <div class="card report-card p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">Booking Status Breakdown</h5>
            
            @{
                var completedPercent = Model.TotalBookings > 0 ? (double)Model.CompletedBookings * 100 / Model.TotalBookings : 0;
                var pendingPercent = Model.TotalBookings > 0 ? (double)Model.PendingBookings * 100 / Model.TotalBookings : 0;
                var cancelledPercent = Model.TotalBookings > 0 ? (double)Model.CancelledBookings * 100 / Model.TotalBookings : 0;
            }

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold text-secondary small">Completed Bookings</span>
                    <span class="fw-bold text-dark small">@Model.CompletedBookings (@completedPercent.ToString("F1")%)</span>
                </div>
                <div class="progress-bar-custom">
                    <div class="progress-fill-success" style="width: @completedPercent.ToString("F1")%;"></div>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold text-secondary small">Pending Bookings</span>
                    <span class="fw-bold text-dark small">@Model.PendingBookings (@pendingPercent.ToString("F1")%)</span>
                </div>
                <div class="progress-bar-custom">
                    <div class="progress-fill-primary" style="width: @pendingPercent.ToString("F1")%;"></div>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold text-secondary small">Cancelled Bookings</span>
                    <span class="fw-bold text-dark small">@Model.CancelledBookings (@cancelledPercent.ToString("F1")%)</span>
                </div>
                <div class="progress-bar-custom">
                    <div class="progress-fill-danger" style="width: @cancelledPercent.ToString("F1")%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Account Distribution -->
    <div class="col-12 col-lg-7">
        <div class="card report-card p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">User Directory Share</h5>
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3 d-flex align-items-center">
                            <span class="badge bg-primary-subtle text-primary me-3 px-3 py-2 fs-6 rounded-pill">Customers</span>
                            <strong class="fs-5">@Model.TotalCustomers</strong>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <span class="badge bg-warning-subtle text-warning me-3 px-3 py-2 fs-6 rounded-pill">Workers</span>
                            <strong class="fs-5">@Model.TotalWorkers</strong>
                        </li>
                        <li class="mb-0 d-flex align-items-center">
                            <span class="badge bg-danger-subtle text-danger me-3 px-3 py-2 fs-6 rounded-pill">Administrators</span>
                            <strong class="fs-5">@Model.TotalAdmins</strong>
                        </li>
                    </ul>
                </div>
                <div class="col-sm-6 text-center">
                    <div class="p-3 border rounded-4 bg-light">
                        <i class="fa-solid fa-users-gear text-muted mb-2" style="font-size: 3rem; opacity: 0.5;"></i>
                        <h6 class="fw-semibold text-secondary mb-1">Total Registered Accounts</h6>
                        <h3 class="fw-bold text-dark mb-0">@(Model.TotalCustomers + Model.TotalWorkers + Model.TotalAdmins)</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Services Performance Table -->
<div class="card report-card p-4">
    <div class="section-head mb-3">
        <div>
            <h5 class="mb-1 fw-bold text-dark">Category Booking & Revenue Breakdown</h5>
            <p class="text-muted mb-0">Performance metrics grouped by service category</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="font-size: 0.85rem; font-weight: 700; color: #475569;">Service Category</th>
                    <th style="font-size: 0.85rem; font-weight: 700; color: #475569;" class="text-center">Total Bookings</th>
                    <th style="font-size: 0.85rem; font-weight: 700; color: #475569;" class="text-end">Total Revenue</th>
                    <th style="font-size: 0.85rem; font-weight: 700; color: #475569;" class="text-end">Average Hourly Rate</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ServicePerformance != null && Model.ServicePerformance.Any())
                {
                    foreach (var item in Model.ServicePerformance)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.CategoryName</td>
                            <td class="text-center fw-semibold">@item.BookingCount.ToString("N0")</td>
                            <td class="text-end fw-semibold text-success">EGP @item.TotalRevenue.ToString("N2")</td>
                            <td class="text-end fw-semibold text-secondary">EGP @item.AverageHourlyRate.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No service performance data available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
