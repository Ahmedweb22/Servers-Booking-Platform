@model IReadOnlyList<Shtbly.Models.WithdrawalRequest>
@using Microsoft.AspNetCore.Localization
@{
    var reqCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var curCulture = reqCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isRtl = curCulture.StartsWith("ar");
    ViewBag.Title = isRtl ? "طلبات سحب الأموال" : "Withdrawal Requests";
}

<style>
    .withdraw-table-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        border: 1px solid #f0f0f0;
        padding: 24px;
    }
    .badge-pending {
        background-color: #fef3c7;
        color: #d97706;
        border: 1.5px solid #fde68a;
    }
    .badge-approved {
        background-color: #d1fae5;
        color: #059669;
        border: 1.5px solid #a7f3d0;
    }
    .badge-rejected {
        background-color: #fee2e2;
        color: #dc2626;
        border: 1.5px solid #fca5a5;
    }
    .badge-status {
        padding: 6px 12px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.85rem;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 @(isRtl ? "flex-row-reverse" : "")">
    <div>
        <h2 class="fw-bold mb-1">@(isRtl ? "طلبات سحب الأموال" : "Withdrawal Requests")</h2>
        <p class="text-muted mb-0">@(isRtl ? "إدارة واعتماد طلبات السحب المالية المقدمة من الفنيين" : "Review and approve/reject pending financial withdrawal requests from workers")</p>
    </div>
</div>

<div class="withdraw-table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary">
                <tr class="@(isRtl ? "text-end" : "text-start")">
                    <th scope="col">#</th>
                    <th scope="col">@(isRtl ? "الفني" : "Worker")</th>
                    <th scope="col">@(isRtl ? "المبلغ" : "Amount")</th>
                    <th scope="col">@(isRtl ? "تاريخ الطلب" : "Requested At")</th>
                    <th scope="col">@(isRtl ? "الحالة" : "Status")</th>
                    <th scope="col" class="text-center">@(isRtl ? "العمليات" : "Actions")</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-cash-stack fs-1 d-block mb-3 opacity-50"></i>
                            @(isRtl ? "لا توجد طلبات سحب حالية." : "No withdrawal requests found.")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.OrderByDescending(x => x.CreatedAt))
                    {
                        var workerName = item.Worker?.User != null ? $"{item.Worker.User.FName} {item.Worker.User.LName}" : "Unknown Worker";
                        if (string.IsNullOrWhiteSpace(workerName.Trim()))
                        {
                            workerName = item.Worker?.User?.UserName ?? "Worker #" + item.WorkerId;
                        }

                        var statusClass = item.Status switch
                        {
                            "Approved" => "badge-approved",
                            "Rejected" => "badge-rejected",
                            _ => "badge-pending"
                        };

                        var statusText = item.Status switch
                        {
                            "Approved" => isRtl ? "مقبول" : "Approved",
                            "Rejected" => isRtl ? "مرفوض" : "Rejected",
                            _ => isRtl ? "قيد الانتظار" : "Pending"
                        };

                        <tr class="@(isRtl ? "text-end" : "text-start")">
                            <td class="fw-bold text-dark">@item.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2 @(isRtl ? "flex-row-reverse" : "")">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary fw-bold" style="width:36px; height:36px;">
                                        @workerName.Substring(0, Math.Min(2, workerName.Length)).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@workerName</div>
                                        <small class="text-muted">@item.Worker?.User?.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-bold text-primary">@item.Amount.ToString("N2") EGP</td>
                            <td class="text-secondary">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge-status @statusClass">@statusText</span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    @if (item.Status == "Pending")
                                    {
                                        <form asp-area="Admin" asp-controller="Withdrawal" asp-action="Approve" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@(isRtl ? "هل أنت متأكد من قبول هذا الطلب؟" : "Are you sure you want to approve this request?")');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm px-3 rounded-pill fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i> @(isRtl ? "موافقة" : "Approve")
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="Withdrawal" asp-action="Reject" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@(isRtl ? "هل أنت متأكد من رفض هذا الطلب؟" : "Are you sure you want to reject this request?")');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm px-3 rounded-pill fw-semibold">
                                                <i class="bi bi-x-circle-fill me-1"></i> @(isRtl ? "رفض" : "Reject")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">@(isRtl ? "تمت معالجته" : "Processed")</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
