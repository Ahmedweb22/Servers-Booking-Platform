@model ResetPasswordVM
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["PageTitle"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; background-color: #f8f9fa; }
        .hero-section {
            background: linear-gradient(rgba(10, 38, 71, 0.85), rgba(10, 38, 71, 0.85)),
                        url('https://images.unsplash.com/photo-1581094794329-c8112a89af12?q=80&w=2070');
            background-size: cover;
            padding: 100px 0 160px;
            color: white;
            text-align: center;
        }
        .auth-card { border: none; border-radius: 25px; overflow: hidden; }
    </style>


<section class="container" style="margin-top: -80px;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
          
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle mb-3" style="width:70px;height:70px;font-size:2rem;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-1">@Localizer["ResetTitle"]</h2>
                    <p class="text-muted small">@Localizer["ResetSubtitle"]</p>
                </div>

                <form asp-action="ResetPassword" id="resetForm">
                  <div asp-validation-summary="ModelOnly" class="text-danger"></div>
               <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold">@Localizer["NewPasswordLabel"]</label>
                        <div class="input-group">
                          
                            <input asp-for="NewPassword" type="password" class="form-control border-start-0 ps-0" id="NewPassword"
                                   placeholder="@Localizer["NewPasswordPlaceholder"]" required minlength="8" autocomplete="new-password">
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                            <button class="btn btn-outline-secondary border-start-0" type="button" id="toggleNew" tabindex="-1" aria-label="إظهار/إخفاء">
                                <i class="bi bi-eye" id="eyeNew"></i>
                            </button>
                            <div class="invalid-feedback">@Localizer["PasswordInvalid"]</div>
                        </div>
                        <!-- Strength bar -->
                        <div class="mt-2">
                            <div class="progress" style="height:5px;border-radius:5px;">
                                <div class="progress-bar" id="strengthBar" role="progressbar" style="width:0%" aria-label="@Localizer["PasswordStrengthLabel"]"></div>
                            </div>
                            <small id="strengthText" class="text-muted"></small>
                        </div>
                    </div>

                    <!-- Password requirements checklist -->
                    <div class="bg-light rounded-3 p-3 mb-3">
                        <p class="small fw-bold mb-2 text-dark">@Localizer["RequirementsTitle"]</p>
                        <ul class="list-unstyled mb-0 small">
                            <li id="req-length" class="text-muted mb-1"><i class="bi bi-circle me-1"></i> @Localizer["ReqLength"]</li>
                            <li id="req-upper"  class="text-muted mb-1"><i class="bi bi-circle me-1"></i> @Localizer["ReqUpper"]</li>
                            <li id="req-number" class="text-muted mb-1"><i class="bi bi-circle me-1"></i> @Localizer["ReqNumber"]</li>
                            <li id="req-special" class="text-muted"><i class="bi bi-circle me-1"></i> @Localizer["ReqSpecial"]</li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <label  asp-for="ConfirmPassword" class="form-label fw-bold">@Localizer["ConfirmPasswordLabel"]</label>
                        <div class="input-group">
                           
                            <input  asp-for="ConfirmPassword"  type="password" class="form-control border-start-0 ps-0" id="ConfirmPassword"
                                   placeholder="@Localizer["ConfirmPasswordPlaceholder"]" required autocomplete="new-password">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>  
                            <button class="btn btn-outline-secondary border-start-0" type="button" id="toggleConfirm" tabindex="-1" aria-label="إظهار/إخفاء">
                                <i class="bi bi-eye" id="eyeConfirm"></i>
                            </button>
                            <div class="invalid-feedback" id="confirmFeedback">@Localizer["ConfirmPasswordInvalid"]</div>
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success fw-bold py-2" style="border-radius:12px;">
                            <i class="bi bi-shield-check me-1"></i> @Localizer["ResetButton"]
                        </button>
                    </div>

                    <div class="text-center">
                        <a asp-action="Login" class="small text-primary text-decoration-none fw-bold">
                            <i class="bi bi-arrow-right me-1"></i> @Localizer["BackToLogin"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Populate hidden fields from URL params
    const params = new URLSearchParams(window.location.search);
    const userIdEl = document.getElementById('UserId');
    if (params.get('userId') && userIdEl) userIdEl.value = params.get('userId');

    function toggleVis(inputId, iconId) {
        const inp = document.getElementById(inputId);
        const ic  = document.getElementById(iconId);
        if (inp && ic) {
            inp.type = inp.type === 'password' ? 'text' : 'password';
            ic.classList.toggle('bi-eye'); ic.classList.toggle('bi-eye-slash');
        }
    }
    document.getElementById('toggleNew').addEventListener('click', () => toggleVis('NewPassword','eyeNew'));
    document.getElementById('toggleConfirm').addEventListener('click', () => toggleVis('ConfirmPassword','eyeConfirm'));

    const PwdStrengthTexts = {
        veryWeak: '@Localizer["PwdVeryWeak"]',
        weak: '@Localizer["PwdWeak"]',
        medium: '@Localizer["PwdMedium"]',
        strong: '@Localizer["PwdStrong"]',
        label: '@Localizer["PasswordStrengthLabel"]'
    };
    const PasswordsMismatchText = '@Localizer["PasswordsMismatch"]';

    // Password strength + requirement checklist
    const newPasswordEl = document.getElementById('NewPassword');
    if (newPasswordEl) {
        newPasswordEl.addEventListener('input', function() {
            const v = this.value;
            const checks = [
                { id:'req-length',  pass: v.length >= 8 },
                { id:'req-upper',   pass: /[A-Z]/.test(v) },
                { id:'req-number',  pass: /[0-9]/.test(v) },
                { id:'req-special', pass: /[^A-Za-z0-9]/.test(v) }
            ];
            checks.forEach(c => {
                const el = document.getElementById(c.id);
                if (el) {
                    const icon = el.querySelector('i');
                    if (c.pass) {
                        el.classList.replace('text-muted','text-success');
                        if (icon) icon.classList.replace('bi-circle','bi-check-circle-fill');
                    } else {
                        el.classList.replace('text-success','text-muted');
                        if (icon) icon.classList.replace('bi-check-circle-fill','bi-circle');
                    }
                }
            });
            const score = checks.filter(c=>c.pass).length;
            const bar = document.getElementById('strengthBar');
            const txt = document.getElementById('strengthText');
            if (bar && txt) {
                const levels = [
                    { pct:'25%', cls:'bg-danger', label: PwdStrengthTexts.veryWeak },
                    { pct:'50%', cls:'bg-warning', label: PwdStrengthTexts.weak },
                    { pct:'75%', cls:'bg-info',    label: PwdStrengthTexts.medium },
                    { pct:'100%',cls:'bg-success', label: PwdStrengthTexts.strong }
                ];
                if (score === 0) { bar.style.width='0%'; txt.textContent=''; return; }
                const l = levels[score-1];
                bar.style.width = l.pct; bar.className = 'progress-bar '+l.cls;
                txt.textContent = PwdStrengthTexts.label + l.label;
                txt.className = 'small '+(score<3?'text-danger':score<4?'text-warning':'text-success');
            }
        });
    }

    const confirmPasswordEl = document.getElementById('ConfirmPassword');
    if (confirmPasswordEl) {
        confirmPasswordEl.addEventListener('input', function() {
            const newPwdEl = document.getElementById('NewPassword');
            if (newPwdEl && this.value === newPwdEl.value) this.setCustomValidity('');
        });
    }

    document.getElementById('resetForm').addEventListener('submit', function(e) {
        const pwdEl = document.getElementById('NewPassword');
        const confEl = document.getElementById('ConfirmPassword');
        if (pwdEl && confEl) {
            const pwd = pwdEl.value;
            if (pwd !== confEl.value) {
                e.preventDefault();
                this.classList.add('was-validated');
                confEl.setCustomValidity(PasswordsMismatchText);
                document.getElementById('confirmFeedback').textContent = PasswordsMismatchText;
                return;
            } else { 
                confEl.setCustomValidity(''); 
            }
        }
        if (!this.checkValidity()) {
            e.preventDefault();
            this.classList.add('was-validated');
            return;
        }
    });
</script>

        @section Scripts {
    <partial name="~/Views/Shared/_NotificationPartial.cshtml" />
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}