@using Microsoft.AspNetCore.Localization
@{
    var reqCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var curCulture = reqCultureFeature?.RequestCulture?.UICulture?.Name ?? "en";
    var isRtl = curCulture.StartsWith("ar");
}
<!DOCTYPE html>
<html lang="@curCulture" dir="@(isRtl ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? Localizer["PageTitle"])</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/css/identity.css">
    @if (isRtl)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    }
    else
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --primary-color: #0b397b;
                --secondary-color: #00c3eb;
                --accent-color: #ff5700;
                --highlight-color: #2C74B3;
                --gold-accent: #F2C94C;
                --bg-color: #F8FAFC;
            }

            [data-theme="dark"] {
                --primary-color: #1e3a5f;
                --secondary-color: #00c3eb;
                --accent-color: #ff5700;
                --highlight-color: #60a5fa;
                --gold-accent: #fbbf24;
                --bg-color: #0f172a;
            }

            [data-theme="dark"] body {
                background-color: #0f172a;
                color: #e2e8f0;
            }

            [data-theme="dark"] .login-choice-card {
                background: #1e293b;
                border-color: #334155;
                color: #e2e8f0;
            }

            [data-theme="dark"] .login-choice-card:hover {
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
            }

            [data-theme="dark"] .card {
                background: #1e293b !important;
                border-color: #334155 !important;
                color: #e2e8f0;
            }

            [data-theme="dark"] .form-control,
            [data-theme="dark"] .form-select {
                background-color: #0f172a !important;
                border-color: #334155 !important;
                color: #e2e8f0 !important;
            }

            [data-theme="dark"] .text-dark { color: #e2e8f0 !important; }
            [data-theme="dark"] .text-muted { color: #94a3b8 !important; }
            [data-theme="dark"] .bg-light { background: #334155 !important; }

            [data-theme="dark"] footer {
                background: #0c1524 !important;
            }

            .theme-toggle-identity {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,0.3);
                background: rgba(255,255,255,0.1);
                backdrop-filter: blur(4px);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: all 0.3s ease;
                font-size: 1.15rem;
            }

            .theme-toggle-identity:hover {
                background: rgba(255,255,255,0.2);
                transform: rotate(20deg);
            }

            body {
                font-family: 'Cairo', sans-serif;
                background-color: var(--bg-color);
                -webkit-font-smoothing: antialiased;
                color: #333;
            }

            /* Hero Section with Glassmorphism */
            .hero-section {
                background: linear-gradient(135deg, rgba(10, 38, 71, 0.9), rgba(32, 82, 149, 0.8)), url('https://images.unsplash.com/photo-1581094794329-c8112a89af12?q=80&w=2070') center/cover no-repeat fixed;
                padding: 60px 0 100px;
                color: white;
                text-align: center;
                position: relative;
                overflow: hidden;
                border-bottom-left-radius: 50px;
                border-bottom-right-radius: 50px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            }

            .hero-content {
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(10px);
                -webkit-backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                padding: 40px;
                border-radius: 30px;
                display: inline-block;
                max-width: 800px;
                animation: fadeInDown 1s ease-out;
            }

            @@keyframes fadeInDown {
                from {
                    opacity: 0;
                    transform: translateY(-30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* Choice Cards */
            .cards-section {
                margin-top: -60px;
                position: relative;
                z-index: 10;
            }

            .login-choice-card {
                border: none;
                border-radius: 30px;
                transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
                cursor: pointer;
                background: #ffffff;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
                height: 100%;
                position: relative;
                overflow: hidden;
                border: 1px solid rgba(0,0,0,0.03);
            }

                .login-choice-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0));
                    z-index: 1;
                    opacity: 0;
                    transition: opacity 0.5s ease;
                }

                .login-choice-card:hover {
                    transform: translateY(-20px);
                    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
                }

                    .login-choice-card:hover::before {
                        opacity: 1;
                    }

                .login-choice-card.worker-card {
                    background: linear-gradient(145deg, #1a1a2e, #16213e);
                    color: white;
                    border: 1px solid rgba(255,255,255,0.05);
                }

            .icon-circle {
                width: 90px;
                height: 90px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 3rem;
                margin: 0 auto 25px;
                transition: transform 0.5s ease;
                position: relative;
                z-index: 2;
            }

            .login-choice-card:hover .icon-circle {
                transform: scale(1.1) rotate(5deg);
            }

            .worker-card .icon-circle {
                background: rgba(242, 201, 76, 0.1);
                color: var(--gold-accent);
                box-shadow: 0 0 20px rgba(242, 201, 76, 0.2);
            }

            .client-card .icon-circle {
                background: rgba(44, 116, 179, 0.1);
                color: var(--highlight-color);
                box-shadow: 0 0 20px rgba(44, 116, 179, 0.2);
            }

            .btn-custom {
                border-radius: 15px;
                padding: 14px 30px;
                font-weight: 700;
                letter-spacing: 0.5px;
                transition: all 0.3s ease;
                position: relative;
                z-index: 2;
            }

                .btn-custom:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 15px rgba(0,0,0,0.1);
                }

            .worker-card .btn-warning {
                background-color: var(--gold-accent);
                border-color: var(--gold-accent);
            }

            .worker-card .btn-outline-warning {
                color: var(--gold-accent);
                border-color: var(--gold-accent);
            }

                .worker-card .btn-outline-warning:hover {
                    background-color: var(--gold-accent);
                    color: #1a1a2e;
                }

            /* Features Section */
            .feature-card {
                background: white;
                padding: 40px 30px;
                border-radius: 25px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.03);
                transition: all 0.4s ease;
                height: 100%;
                border: 1px solid rgba(0,0,0,0.02);
            }

                .feature-card:hover {
                    transform: translateY(-10px);
                    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
                    border-color: rgba(44, 116, 179, 0.1);
                }

            .feature-icon-wrapper {
                width: 70px;
                height: 70px;
                background: linear-gradient(135deg, var(--highlight-color), var(--primary-color));
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 20px;
                transform: rotate(-5deg);
                transition: transform 0.4s ease;
            }

            .feature-card:hover .feature-icon-wrapper {
                transform: rotate(0deg) scale(1.05);
            }

            .feature-icon-wrapper i {
                font-size: 2rem;
                color: white;
            }

            /* Footer */
            footer {
                background: linear-gradient(180deg, #112B4C 0%, #0A192F 100%);
                border-top: 4px solid var(--highlight-color);
                position: relative;
                overflow: hidden;
            }

            .footer-glow {
                position: absolute;
                top: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 600px;
                height: 300px;
                background: radial-gradient(circle, rgba(44,116,179,0.15) 0%, rgba(0,0,0,0) 70%);
                pointer-events: none;
            }

            .hover-link {
                transition: all 0.3s ease;
                display: inline-block;
            }

                .hover-link:hover {
                    color: var(--gold-accent) !important;
                    transform: translateX(-5px);
                    opacity: 1 !important;
                }

            .social-icon {
                width: 45px;
                height: 45px;
                border-radius: 50%;
                background: rgba(255,255,255,0.05);
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s ease;
                border: 1px solid rgba(255,255,255,0.1);
            }

                .social-icon:hover {
                    background: var(--highlight-color);
                    transform: translateY(-3px);
                    box-shadow: 0 5px 15px rgba(44, 116, 179, 0.4);
                    color: white !important;
                }

    </style>
</head>

<body>

    <header class="hero-section">
        <div style="position: absolute; top: 20px; right: 20px; z-index: 100; display: flex; align-items: center; gap: 10px;">
            <button class="theme-toggle-identity" id="themeToggleBtn" type="button" title="Toggle dark/light mode">
                <i class="bi bi-moon-fill" id="themeIcon"></i>
            </button>
            @await Html.PartialAsync("_LanguageSwitcher")
        </div>
        <div class="container">
            <div class="hero-content">
                <h1 class="display-4 fw-bold mb-3">@(ViewData["HeroTitle"] ?? Localizer["HeroTitle"])</h1>
                <p class="lead fs-4 mb-0 opacity-75">@(ViewData["HeroSubtitle"] ?? Localizer["HeroSubtitle"])</p>
            </div>
        </div>
    </header>


    @RenderBody()


    <footer class="text-white pt-5 pb-3">
        <div class="footer-glow"></div>
        <div class="container position-relative z-1">
            <div class="row g-4 text-center text-md-end mb-4">

                <div class="col-lg-4 col-md-6 mb-4 mb-md-0">
                    <h3 class="fw-bold mb-3" style="color: var(--gold-accent);">@Localizer["FooterBrand"]</h3>
                    <p class="text-light opacity-75 pe-md-4">
                        @Localizer["FooterDescription"]
                    </p>
                </div>

                <div class="col-lg-4 col-md-6 mb-4 mb-md-0">
                    <h5 class="fw-bold mb-4 text-white">@Localizer["QuickLinks"]</h5>
                    <ul class="list-unstyled">
                        <li class="mb-3"><a asp-area="Customer" asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none opacity-75 hover-link"><i class="bi @(isRtl ? "bi-chevron-left" : "bi-chevron-right") me-2 small"></i>@Localizer["PrivacyPolicy"]</a></li>
                        <li class="mb-3"><a asp-area="Customer" asp-controller="Home" asp-action="Terms" class="text-white text-decoration-none opacity-75 hover-link"><i class="bi @(isRtl ? "bi-chevron-left" : "bi-chevron-right") me-2 small"></i>@Localizer["TermsAndConditions"]</a></li>
                        <li><a asp-area="Customer" asp-controller="Home" asp-action="Contact" class="text-white text-decoration-none opacity-75 hover-link"><i class="bi @(isRtl ? "bi-chevron-left" : "bi-chevron-right") me-2 small"></i>@Localizer["ContactUs"]</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h5 class="fw-bold mb-4 text-white">@Localizer["FollowUs"]</h5>
                    <div class="d-flex justify-content-center justify-content-md-start gap-3">
                        <a href="#" class="text-white fs-5 social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white fs-5 social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white fs-5 social-icon"><i class="bi bi-whatsapp"></i></a>
                        <a href="#" class="text-white fs-5 social-icon"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>

            </div>

            <hr class="border-light opacity-10 my-4">
            <div class="text-center">
                <p class="small text-light opacity-50 mb-0">
                    @Localizer["Copyright"]
                </p>
            </div>
        </div>
    </footer>
	<script src="~/js/identity.js"></script>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)

    <script>
        (function () {
            const html = document.documentElement;
            const btn  = document.getElementById('themeToggleBtn');
            const icon = document.getElementById('themeIcon');
            function applyTheme(theme) {
                html.setAttribute('data-theme', theme);
                if (icon) {
                    icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
                }
            }
            const saved = localStorage.getItem('shtbly-theme') || 'light';
            applyTheme(saved);
            if (btn) {
                btn.addEventListener('click', function () {
                    const current = html.getAttribute('data-theme') || 'light';
                    const next = current === 'dark' ? 'light' : 'dark';
                    applyTheme(next);
                    localStorage.setItem('shtbly-theme', next);
                });
            }
        })();
    </script>
</body>

</html>